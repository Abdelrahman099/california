---
// The smaller header: one row with a bigger logo. Same links as the live site, including its top bar.
// variant: clean (white), navy, badge (seal hangs below the bar), center (seal in the middle).
import { asset, MAIN_SITE, PHONE, PHONE_HREF } from '../config';

const { variant = 'clean' } = Astro.props;
const admission = [
  { href: `${MAIN_SITE}/apply-for-admission`, label: 'Apply', note: 'Learn more today' },
  { href: `${MAIN_SITE}/financial-aid`, label: 'Aid & Funding', note: 'Options to help you start' },
  { href: `${MAIN_SITE}/how-to-apply-cdap`, label: 'How to Enroll?', note: 'The steps to get in' },
];
const resources = [
  { href: `${MAIN_SITE}/free-resources`, label: 'Free Resources' },
  { href: `${MAIN_SITE}/calendar`, label: 'Calendar' },
  { href: `${MAIN_SITE}/program-demo`, label: 'Program Demo' },
  { href: 'https://help.californiadentalassistant.com/', label: 'Help' },
  { href: 'https://portal.californiadentalassistant.com', label: 'Employees' },
];
const Chevron = '<svg viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<header class={`sh sh--${variant}`} data-sh>
  <div class="sh-bar">
    <a class="sh-logo" href={MAIN_SITE} aria-label="California Dental Assistant Program home">
      <img src={asset('images/logo-seal.png')} width="500" height="500" alt="" />
      <span class="sh-name"><b>California Dental</b><small>Assistant Program</small></span>
    </a>

    <nav class="sh-nav" id="sh-nav" aria-label="Main">
      <a class="sh-link" href={`${MAIN_SITE}/about`}>About</a>
      <div class="sh-drop" data-drop>
        <button type="button" class="sh-link" aria-expanded="false">Admission <Fragment set:html={Chevron} /></button>
        <div class="sh-panel">
          {admission.map((a) => <a href={a.href}><b>{a.label}</b><small>{a.note}</small></a>)}
        </div>
      </div>
      <div class="sh-drop" data-drop>
        <button type="button" class="sh-link" aria-expanded="false">Resources <Fragment set:html={Chevron} /></button>
        <div class="sh-panel">
          {resources.map((a) => <a href={a.href}><b>{a.label}</b></a>)}
        </div>
      </div>
      <a class="sh-link" href={`${MAIN_SITE}/contact-us`}>Contact Us</a>
      <a class="sh-link sh-only-menu" href="https://portal.californiadentalassistant.com/login">Student Portal</a>
      <a class="sh-link sh-only-menu" href="mailto:info@californiadentalassistant.com">info@californiadentalassistant.com</a>
      <a class="sh-link sh-only-menu" href={PHONE_HREF}>{PHONE}</a>
    </nav>

    <div class="sh-actions">
      <button type="button" class="sh-icon" data-sh-search aria-label="Search" aria-expanded="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <a class="sh-portal" href="https://portal.californiadentalassistant.com/login" target="_blank" rel="noopener">Student Portal</a>
      <a class="sh-phone" href={PHONE_HREF}>{PHONE}</a>
      <a class="sh-apply" href="#apply">Apply Now</a>
      <button type="button" class="sh-burger" data-sh-burger aria-label="Open menu" aria-expanded="false" aria-controls="sh-nav"><span></span><span></span><span></span></button>
    </div>
  </div>
  <form class="sh-search" action={`${MAIN_SITE}/search`} hidden>
    <label class="sh-search-label" for="sh-q">Search</label>
    <input id="sh-q" name="query" type="search" placeholder="Search..." required />
    <button type="submit">Search</button>
  </form>
</header>

<style is:global>
  html {
    scroll-padding-top: 96px;
  }
  .sh {
    --sh-h: 84px;
    --sh-bg: #fff;
    --sh-text: var(--navy-deep);
    --sh-line: var(--line);
    --sh-seal: 60px;
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--sh-bg);
    border-bottom: 1px solid var(--sh-line);
    color: var(--sh-text);
  }
  .sh--navy {
    --sh-bg: var(--navy-deep);
    --sh-text: #fff;
    --sh-line: rgba(255, 255, 255, 0.14);
  }
  .sh--badge,
  .sh--center {
    --sh-h: 72px;
    --sh-seal: 112px;
  }
  .sh-bar {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 32px);
    height: var(--sh-h);
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(16px, 2.6vw, 40px);
  }
  .sh-logo {
    display: flex;
    flex: none;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }
  .sh-logo img {
    width: var(--sh-seal);
    height: var(--sh-seal);
    border-radius: 50%;
    transition: width 0.2s ease, height 0.2s ease, margin 0.2s ease;
  }
  .sh-name {
    display: grid;
    line-height: 1.08;
    text-transform: uppercase;
  }
  .sh-name b {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.005em;
  }
  .sh-name small {
    margin-top: 3px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.135em;
  }
  /* The seal hangs below the bar and tucks back in once the page scrolls. */
  .sh--badge .sh-logo,
  .sh--center .sh-logo {
    align-items: flex-start;
    height: var(--sh-h);
  }
  .sh--badge .sh-logo img,
  .sh--center .sh-logo img {
    margin-top: 8px;
    background: #fff;
  }
  .sh--badge .sh-name {
    align-self: center;
  }
  .sh--badge.is-stuck .sh-logo img,
  .sh--center.is-stuck .sh-logo img {
    width: 56px;
    height: 56px;
    box-shadow: none;
  }
  .sh--center .sh-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
  }
  .sh--center .sh-logo {
    grid-column: 2;
    grid-row: 1;
  }
  .sh--center .sh-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .sh--center .sh-nav {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
  }
  .sh--center .sh-actions {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    margin: 0;
  }
  .sh-nav {
    display: flex;
    align-items: center;
    gap: clamp(2px, 0.8vw, 12px);
    margin-left: clamp(4px, 1.4vw, 24px);
  }
  .sh-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding: 0 10px;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    font: 500 16px var(--font);
    text-decoration: none;
    white-space: nowrap;
  }
  .sh-link svg {
    width: 11px;
    height: 8px;
  }
  .sh-only-menu {
    display: none;
  }
  .sh-drop {
    position: relative;
  }
  .sh-panel {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 2;
    display: none;
    min-width: 260px;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fff;
    box-shadow: 0 12px 28px rgba(8, 39, 67, 0.16);
  }
  .sh-drop.is-open .sh-panel {
    display: block;
  }
  .sh-panel a {
    display: block;
    padding: 9px 12px;
    border-radius: 4px;
    color: var(--navy-deep);
    text-decoration: none;
  }
  .sh-panel a:hover,
  .sh-panel a:focus-visible {
    background: var(--wash);
  }
  .sh-panel b {
    display: block;
    font-size: 16px;
    font-weight: 600;
  }
  .sh-panel small {
    display: block;
    color: var(--muted);
    font-size: 13px;
  }
  .sh-actions {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.2vw, 18px);
    margin-left: auto;
  }
  .sh-icon,
  .sh-burger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .sh-icon svg {
    width: 21px;
    height: 21px;
  }
  .sh-portal,
  .sh-phone {
    color: inherit;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .sh-portal {
    font-weight: 500;
  }
  .sh-apply {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 0 20px;
    border-radius: 4px;
    background: var(--gold);
    color: var(--navy-deep);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .sh-apply:hover {
    background: var(--gold-hover);
  }
  .sh-burger {
    display: none;
    gap: 5px;
    align-content: center;
  }
  .sh-burger span {
    display: block;
    width: 24px;
    height: 2px;
    background: currentColor;
  }
  .sh-search {
    display: flex;
    gap: 8px;
    max-width: 1440px;
    margin-inline: auto;
    padding: 0 clamp(16px, 2.6vw, 40px) 14px;
  }
  .sh-search[hidden] {
    display: none;
  }
  .sh-search-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .sh-search input {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 12px;
    border: 1px solid #aab4c3;
    border-radius: 4px;
    background: #fff;
    color: var(--ink);
    font: 500 16px var(--font);
  }
  .sh-search button {
    height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: 4px;
    background: var(--gold);
    color: var(--navy-deep);
    cursor: pointer;
    font: 700 15px var(--font);
  }

  @media (max-width: 1320px) {
    .sh-phone {
      display: none;
    }
  }
  @media (max-width: 1140px) {
    .sh-portal {
      display: none;
    }
  }
  @media (max-width: 1040px) {
    .sh-name b {
      font-size: 17px;
    }
    .sh-name small {
      font-size: 11px;
    }
  }
  /* Tablets and phones: bar, seal and menu button, with the links in a panel below. */
  @media (max-width: 991px) {
    .sh {
      --sh-h: 68px;
      --sh-seal: 50px;
    }
    .sh-bar,
    .sh--center .sh-bar {
      display: flex;
    }
    .sh--badge .sh-logo,
    .sh--center .sh-logo {
      align-items: center;
      height: auto;
    }
    .sh--badge .sh-logo img,
    .sh--center .sh-logo img {
      width: var(--sh-seal);
      height: var(--sh-seal);
      margin: 0;
      box-shadow: none;
    }
    .sh--center .sh-name {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
    .sh--center .sh-actions {
      margin-left: auto;
    }
    .sh-name b {
      font-size: 15px;
    }
    .sh-name small {
      font-size: 10px;
    }
    .sh-burger {
      display: grid;
    }
    .sh-icon {
      display: none;
    }
    .sh-apply {
      min-height: 40px;
      padding: 0 12px;
      font-size: 14px;
    }
    .sh-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      max-height: calc(100dvh - var(--sh-h));
      margin: 0;
      padding: 8px 12px 16px;
      overflow-y: auto;
      border-top: 1px solid var(--sh-line);
      background: var(--sh-bg);
      box-shadow: 0 16px 28px rgba(8, 39, 67, 0.18);
    }
    .sh-nav.is-open {
      display: flex;
    }
    .sh-link {
      justify-content: space-between;
      width: 100%;
      min-height: 48px;
      font-size: 17px;
      overflow-wrap: anywhere;
      white-space: normal;
    }
    .sh-only-menu {
      display: inline-flex;
    }
    .sh-panel {
      position: static;
      min-width: 0;
      border: 0;
      box-shadow: none;
      background: transparent;
      padding: 0 0 6px 10px;
    }
    .sh-panel a {
      color: inherit;
    }
    .sh-panel small {
      color: inherit;
      opacity: 0.75;
    }
    .sh-panel a:hover {
      background: none;
    }
  }
  @media (max-width: 440px) {
    .sh-bar {
      gap: 6px;
      padding-inline: 12px;
    }
    .sh {
      --sh-seal: 44px;
    }
    .sh-logo {
      gap: 8px;
    }
    .sh-name b {
      font-size: 13px;
    }
    .sh-name small {
      font-size: 8.5px;
    }
    .sh-actions {
      gap: 2px;
    }
    .sh-apply {
      min-height: 38px;
      padding: 0 10px;
      font-size: 13px;
    }
  }
  @media (max-width: 374px) {
    .sh-apply {
      display: none;
    }
  }
</style>
