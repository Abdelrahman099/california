---
import Layout from '../layouts/Layout.astro';
import {
  asset,
  videoEmbed,
  PREVIEW_VIDEO_URL,
  PREVIEW_VIDEO_CAPTIONS,
  PREVIEW_VIDEO_STREAM,
  BOOKING_URL,
  APPLICATION_URL,
  GHL_EMBED_SCRIPT,
  MAIN_SITE,
  PHONE,
  PHONE_HREF,
  EMAIL,
  ADDRESS,
} from '../config';

const video = videoEmbed(PREVIEW_VIDEO_URL);
const BOOK_LABEL = 'Book my admissions appointment';
const LICENSE = '6085';
const TUITION = '$4,500';

// Chapters of the Virtual Preview recording (seconds from the start).
const chapters = [
  { t: 0, time: '0:00', label: 'Welcome and Dental Board approval' },
  { t: 46, time: '0:46', label: 'Who the program is for' },
  { t: 69, time: '1:09', label: 'Why dentistry, why now' },
  { t: 139, time: '2:19', label: 'The 8 certifications you earn' },
  { t: 168, time: '2:48', label: 'How the program works' },
  { t: 286, time: '4:46', label: 'Student Success team' },
  { t: 327, time: '5:27', label: 'Community and student portal' },
  { t: 430, time: '7:10', label: 'Tuition' },
  { t: 465, time: '7:45', label: 'Next steps' },
];

const stats = [
  { value: '8', label: 'Certifications and licenses included' },
  { value: '300', label: 'Hours of self-paced online learning' },
  { value: '3', label: 'Hands-on clinical days with licensed instructors' },
  { value: '240', label: 'Internship hours in a real dental office' },
];

const appointment = [
  {
    label: 'Your goals',
    text: 'Tell your advisor where you are now and where you want to be. They’ll check that the program fits your schedule.',
  },
  {
    label: 'Your applications',
    text: 'Your advisor sends you the student application and the scholarship application so you can get them started.',
  },
  {
    label: 'Your tuition',
    text: 'Go over tuition and any scholarships you qualify for, so you know your final cost before you commit.',
  },
  {
    label: 'Your start date',
    text: 'Pick when you start. You can enroll as soon as the next day, depending on advisor availability.',
  },
];

const audience = [
  {
    title: 'Pre-dental students',
    text: 'Heading toward dental hygiene or dental school? Get real chairside experience first.',
  },
  {
    title: 'Recent high school graduates',
    text: 'Age 17 or older and ready to start a healthcare career without years of school.',
  },
  {
    title: 'Working adults',
    text: 'Looking for a stable career with room to grow, on a schedule that works around your job.',
  },
];

const whyNow = [
  { value: '7%', label: 'Projected job growth for dental assistants over the next 10 years', src: 'U.S. Bureau of Labor Statistics' },
  { value: '52,900', label: 'Dental assistant openings per year', src: 'U.S. Bureau of Labor Statistics' },
  { value: '#1', label: 'California ranked the top state for dental assistant career growth', src: 'Dental Assisting National Board' },
];

const certifications = [
  'Dental Practice Act',
  'HIPAA',
  'OSHA Bloodborne Pathogens',
  'Sexual Harassment Prevention',
  'AHA BLS / CPR',
  'Infection Control',
  'Radiation Safety',
  'Dental Assistant Certification',
];

const inside = [
  {
    n: '#1',
    title: 'How the program works',
    body: 'A self-paced program with three parts. You have 12 months of access, and the fastest students finish in 8 to 12 weeks.',
    points: [
      '300 hours online: videos, readings, quizzes and sessions with our team',
      '3 hands-on classes at a partner dental office, usually Friday to Sunday, at 25+ locations',
      '240-hour internship at a dental clinic, paid or unpaid, and we help you find one',
    ],
    img: 'images/learn-xray.jpg',
    alt: 'A CDA Program student practicing dental X-ray positioning on a classmate.',
  },
  {
    n: '#2',
    title: 'Support from start to finish',
    body: 'You’re never on your own. Our Student Success team is with you for the full 12 months, even if you finish early.',
    points: [
      'Student Success team available 9 AM to 6 PM, Monday through Saturday',
      'Weekly check-ins during your internship',
      'A community of 200+ students sharing jobs, internships and scholarships',
    ],
    img: 'images/learn-chairside.jpg',
    alt: 'A student in protective gear working chairside at a dental operatory.',
  },
  {
    n: '#3',
    title: 'One tuition, everything included',
    body: `Tuition is ${TUITION}, and it covers the whole program. No extra fees for classes or materials.`,
    points: [
      'All 300 online hours, 3 hands-on classes and the 240-hour internship',
      'All 8 certifications and licenses',
      'Materials, plus your own pair of scrubs',
    ],
    img: 'images/learn-graduate.jpg',
    alt: 'A CDA Program graduate in scrubs ready for her first dental job.',
  },
];

const quotes = [
  {
    text: 'The program has modern equipment and helps with job placement. I highly recommend this program to anyone who wants to be a dental assistant!',
    name: 'Yadira Martinez',
    role: 'Dental Assisting Program Student',
  },
  {
    text: 'If you’re looking to accelerate your career as a dental assistant, this should be your one and only choice.',
    name: 'Jessica P.',
    role: 'Alumni Student',
  },
  {
    text: 'If you’re on the fence about joining, let this comment be the nudge you need. You won’t regret it.',
    name: 'Osamah Al Janabi',
    role: 'Dental Assistant Program Student',
  },
];

const faqs = [
  {
    q: 'What is the Initial Student Admissions Appointment?',
    a: 'A free 1-on-1 call with a CDA Program admissions advisor. They’ll answer your questions, send you the student and scholarship applications, and help you plan your start date.',
  },
  {
    q: 'Does booking the appointment commit me to enrolling?',
    a: 'No. The appointment is free and there’s no obligation.',
  },
  {
    q: 'Is the program accredited?',
    a: `The California Dental Assistant Program is an approved continuing education provider through the Dental Board of California, license #${LICENSE}.`,
  },
  {
    q: 'How much does the program cost?',
    a: `Tuition is ${TUITION}, and everything is included: online learning, 3 hands-on classes, the 240-hour internship, all 8 certifications and licenses, materials and scrubs. Ask your advisor about scholarships.`,
  },
  {
    q: 'How long does the program take?',
    a: 'It’s self-paced. You have 12 months of access, and the fastest students finish in 8 to 12 weeks.',
  },
  {
    q: 'When are the hands-on classes?',
    a: 'There are 3 hands-on classes in total. They take place at a partner dental office on its day off, usually Friday, Saturday or Sunday, and you can schedule them any time within your 12 months.',
  },
  {
    q: 'Do I need to find my own internship?',
    a: 'The program includes a 240-hour internship, which can be paid or unpaid. If you need help finding one, we’ll help you.',
  },
  {
    q: 'Who can enroll?',
    a: 'Anyone 17 or older, including pre-dental students, recent high school graduates and working adults. No dental experience needed.',
  },
  {
    q: 'How soon can I start?',
    a: 'You can enroll as soon as the next day (unless it’s a Sunday), depending on advisor availability. Book your admissions appointment to get started.',
  },
  {
    q: 'Should I apply before my appointment?',
    a: 'You don’t have to. Your advisor will send you the student application and scholarship application. If you’re already sure, you can start the application on this page.',
  },
];

const title = 'Virtual Preview | California Dental Assistant Program';
const description =
  'Watch the free Virtual Preview of the California Dental Assistant Program, then book your Initial Student Admissions Appointment.';
---

<Layout title={title} description={description}>
  <!-- Top bar -->
  <a class="topbar" href="#book">
    <span class="wrap topbar-inner">
      <span class="badge"><span class="dot" aria-hidden="true"></span>Free</span>
      <span>Watch the Virtual Preview, then book your appointment</span>
    </span>
  </a>

  <!-- Header -->
  <header class="site-header">
    <div class="wrap header-inner">
      <a href={MAIN_SITE} class="brand" aria-label="California Dental Assistant Program home">
        <img src={asset('images/logo-lockup.png')} alt="California Dental Assistant Program" width="276" height="86" />
      </a>
      <div class="header-actions">
        <a href={PHONE_HREF} class="header-phone">{PHONE}</a>
        <a href="#book" class="btn btn-gold btn-sm">Book appointment</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- Hero: the Virtual Preview -->
    <section class="hero">
      <div class="wrap hero-inner">
        <div class="hero-head">
          <span class="eyebrow">Dental Assistant Program · Virtual Preview</span>
          <h1>Is a dental career the change you’ve been waiting for?</h1>
          <p class="hero-sub">
            Watch this free 9-minute preview to see how you could become a dental assistant in as little as 8 to 12 weeks.
            Then book your admissions appointment to get your personal plan.
          </p>
        </div>

        <div class="watch">
          <div class={`player ${video?.kind === 'file' ? 'player-file' : ''}`} id="preview">
            {video?.kind === 'iframe' && (
              <iframe
                src={video.src}
                title="CDA Program Virtual Preview"
                allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
                allowfullscreen
              ></iframe>
            )}
            {video?.kind === 'file' && (
              <>
                <video
                  id="preview-video"
                  controls
                  playsinline
                  preload="none"
                  data-hls={asset(PREVIEW_VIDEO_STREAM)}
                  data-mp4={video.src}
                >
                  <track kind="captions" src={asset(PREVIEW_VIDEO_CAPTIONS)} srclang="en" label="English" />
                </video>
                <button class="cover" type="button" data-play aria-label="Play the Virtual Preview, 8 minutes 46 seconds">
                  <img src={asset('images/hero-clinic.jpg')} alt="" width="1600" height="1066" />
                  <span class="cover-text">
                    <span class="cover-eyebrow">Free Virtual Preview</span>
                    <span class="cover-title">See how the Dental Assistant Program works</span>
                    <span class="cover-meta">8:46 · Recorded live</span>
                  </span>
                  <span class="play" aria-hidden="true"></span>
                </button>
              </>
            )}
            {!video && (
              <div class="player-placeholder" style={`background-image:url(${asset('images/hero-clinic.jpg')})`}>
                <span class="play" aria-hidden="true"></span>
                <span class="player-note">Virtual Preview recording goes here</span>
              </div>
            )}
          </div>
          {video?.kind === 'file' && (
            <nav class="chapters" aria-label="Jump to a part of the preview">
              <span class="chapters-head">Jump to</span>
              <ol>
                {chapters.map((c) => (
                  <li>
                    <button type="button" data-seek={c.t}>
                      <span class="chapter-time">{c.time}</span> {c.label}
                    </button>
                  </li>
                ))}
              </ol>
            </nav>
          )}
        </div>

        <div class="hero-cta">
          <a href="#book" class="btn btn-gold btn-lg">{BOOK_LABEL} <span class="arrow" aria-hidden="true">→</span></a>
          <span class="cta-note">Free 1-on-1 call with an admissions advisor · No obligation</span>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="stats" aria-label="Program results">
      <div class="wrap stats-grid">
        {stats.map((s) => (
          <div class="stat">
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Next step: the appointment -->
    <section class="section next">
      <div class="wrap next-grid">
        <div class="next-copy">
          <span class="eyebrow">Your next step</span>
          <h2>Book your Initial Student Admissions Appointment</h2>
          <p>
            The preview shows you how the program works. Your appointment turns it into a plan for you. In one free call,
            an admissions advisor will cover:
          </p>
          <a href="#book" class="btn btn-gold">{BOOK_LABEL} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <ol class="agenda">
          {appointment.map((a) => (
            <li>
              <span class="agenda-label">{a.label}</span>
              <p>{a.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Who it's for + why now -->
    <section class="section who">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Who this is for</span>
          <h2>Built for busy people who want a stable healthcare career</h2>
        </div>
        <ul class="audience">
          {audience.map((a) => (
            <li>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </li>
          ))}
        </ul>

        <div class="why">
          <div class="why-head">
            <span class="eyebrow">Why now</span>
            <h3>California needs dental assistants</h3>
            <p>There’s a dental assistant shortage, and demand keeps growing.</p>
          </div>
          <dl class="why-stats">
            {whyNow.map((w) => (
              <div class="why-stat">
                <dt>{w.value}</dt>
                <dd>
                  {w.label}
                  <span class="why-src">Source: {w.src}</span>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- Inside the preview -->
    <section class="section inside">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Inside the preview</span>
          <h2>Three things you’ll learn in the preview</h2>
          <p>It follows the same path a new student does, from first lesson to first paycheck.</p>
        </div>
        <ol class="inside-list">
          {inside.map((item, i) => (
            <li class={`inside-row ${i % 2 ? 'flip' : ''}`}>
              <div class="inside-media">
                <img src={asset(item.img)} alt={item.alt} loading="lazy" width="900" height="1273" />
              </div>
              <div class="inside-copy">
                <span class="inside-num">{item.n}</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                <ul class="checks">
                  {item.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
        <div class="center-cta">
          <a href="#book" class="btn btn-gold">{BOOK_LABEL} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- Certifications -->
    <section class="section certs">
      <div class="wrap certs-grid">
        <div class="certs-head">
          <span class="eyebrow eyebrow-light">Included in your tuition</span>
          <h2>All 8 certifications and licenses you need to work in California</h2>
          <p>Every certification required to practice as a dental assistant in California is part of the program.</p>
          <a href="#book" class="btn btn-gold">{BOOK_LABEL} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <ul class="cert-list checks checks-light">
          {certifications.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Social proof -->
    <section class="section proof">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Student stories</span>
          <h2>What people are saying</h2>
        </div>
        <div class="proof-grid">
          <figure class="video-card">
            <video
              controls
              preload="none"
              playsinline
              poster={asset('videos/testimonial-poster.jpg')}
              aria-label="Dental assistant student testimonial video"
            >
              <source src={asset('videos/testimonial.mp4')} type="video/mp4" />
            </video>
            <figcaption>A CDA Program student on her experience</figcaption>
          </figure>
          <div class="quotes">
            {quotes.map((q) => (
              <blockquote class="quote">
                <p>“{q.text}”</p>
                <footer>
                  <strong>{q.name}</strong>
                  <span>{q.role}</span>
                </footer>
              </blockquote>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Book (primary) -->
    <section class="book" id="book">
      <div class="wrap book-grid">
        <div class="book-copy">
          <img class="seal" src={asset('images/logo-seal.png')} alt="" width="120" height="120" />
          <span class="eyebrow eyebrow-light">Initial Student Admissions Appointment</span>
          <h2>Pick a time that works for you</h2>
          <p>Choose a day and time below. Your admissions advisor will call you at your appointment time.</p>
          <ul class="checks checks-light">
            <li>Free 1-on-1 call, no obligation</li>
            <li>Your personal start date and training location</li>
            <li>Your exact tuition and financing options</li>
          </ul>
          <p class="book-help">Can’t find a time that works? Call us at <a href={PHONE_HREF}>{PHONE}</a>.</p>
        </div>
        <div class="embed-card" data-embed="booking">
          <iframe
            src={BOOKING_URL}
            title="Book your Initial Student Admissions Appointment"
            scrolling="no"
            id="booking-calendar"
            style="width:100%;min-height:720px;border:none;overflow:hidden"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- Apply (secondary) -->
    <section class="section apply" id="apply">
      <div class="wrap apply-inner">
        <div class="apply-head">
          <span class="eyebrow">Already decided?</span>
          <h2>Start your student application</h2>
          <p>
            If you already know you want to enroll, you can submit your application now. Please still book your admissions
            appointment above so your advisor can review it with you and confirm your start date.
          </p>
        </div>
        <details class="apply-toggle" id="apply-form">
          <summary>
            <span>Open the student application</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div class="embed-card embed-card-light" data-embed="application">
            <iframe
              src={APPLICATION_URL}
              title="CDA Program Student Application"
              scrolling="no"
              id="student-application"
              style="width:100%;min-height:900px;border:none;overflow:hidden"
            ></iframe>
          </div>
        </details>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section faq-section">
      <div class="wrap faq-grid">
        <div class="faq-intro">
          <span class="eyebrow">Questions</span>
          <h2>Frequently asked questions</h2>
          <p>Still have a question? Your admissions advisor can answer it during your appointment.</p>
          <a href="#book" class="btn btn-gold">{BOOK_LABEL} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="faq">
          {faqs.map((f, i) => (
            <details class="faq-item" id={`faq-${i + 1}`} open={i === 0}>
              <summary>
                <span>{f.q}</span>
                <span class="plus" aria-hidden="true"></span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div class="footer-brand">
        <img src={asset('images/logo-lockup-white.png')} alt="California Dental Assistant Program" width="220" height="69" />
        <p>Dental Board of California–approved continuing education provider, license #{LICENSE}.</p>
      </div>
      <nav class="footer-links" aria-label="Program">
        <span class="footer-head">Program</span>
        <a href={`${MAIN_SITE}/courses`}>Courses</a>
        <a href={`${MAIN_SITE}/financial-aid`}>Financial aid</a>
        <a href={`${MAIN_SITE}/faq`}>FAQ</a>
        <a href={`${MAIN_SITE}/contact-us`}>Contact us</a>
      </nav>
      <div class="footer-contact">
        <span class="footer-head">Contact</span>
        <a href={PHONE_HREF}>{PHONE}</a>
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <span>{ADDRESS}</span>
      </div>
    </div>
    <div class="wrap footer-legal">
      <p>
        Results described on this page are not typical and are not guaranteed. Completion times, job placement and outcomes
        depend on each student’s effort, schedule and local job market. Program details are subject to change.
      </p>
      <p>
        © 2026 California Dental Assistant Program ·
        <a href={`${MAIN_SITE}/privacy-policy`}>Privacy Policy</a> ·
        <a href={`${MAIN_SITE}/terms-and-conditions`}>Terms and Conditions</a>
      </p>
    </div>
  </footer>

  <!-- Sticky booking bar on phones -->
  <div class="mobile-bar" data-mobile-bar>
    <a href="#book" class="btn btn-gold">{BOOK_LABEL}</a>
  </div>

  <script is:inline src={GHL_EMBED_SCRIPT}></script>
  <script>
    // Virtual Preview player: streams the video (works on iPhone and every browser),
    // hides the cover when it starts, and handles chapter jumps.
    const v = document.getElementById('preview-video') as HTMLVideoElement | null;
    if (v) {
      const cover = document.querySelector<HTMLElement>('[data-play]');
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-seek]'));
      let attached: Promise<void> | null = null;
      let started = false;

      const attach = () => {
        if (attached) return attached;
        attached = (async () => {
          const hlsUrl = v.dataset.hls || '';
          const mp4Url = v.dataset.mp4 || '';
          if (hlsUrl && v.canPlayType('application/vnd.apple.mpegurl')) {
            v.src = hlsUrl; // Safari and iPhone play streams natively
            return;
          }
          try {
            const { default: Hls } = await import('hls.js');
            if (hlsUrl && Hls.isSupported()) {
              const hls = new Hls({ startPosition: 0 });
              hls.loadSource(hlsUrl);
              hls.attachMedia(v);
              return;
            }
          } catch (e) {
            /* fall back to the plain file below */
          }
          v.src = mp4Url;
        })();
        return attached;
      };

      const start = async (t?: number) => {
        if (cover) cover.hidden = true;
        started = true;
        await attach();
        if (typeof t === 'number') {
          const seek = () => {
            v.currentTime = t;
          };
          if (v.readyState >= 1) seek();
          else v.addEventListener('loadedmetadata', seek, { once: true });
        }
        v.play().catch(() => {});
      };

      cover?.addEventListener('click', () => start());
      v.addEventListener('play', () => {
        if (cover) cover.hidden = true;
      });
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          start(Number(b.dataset.seek));
          v.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }),
      );
      v.addEventListener('timeupdate', () => {
        let cur: HTMLButtonElement | null = null;
        for (const b of buttons) if (v.currentTime >= Number(b.dataset.seek)) cur = b;
        buttons.forEach((b) => b.classList.toggle('is-current', started && b === cur));
      });
    }
  </script>
  <script is:inline>
    // Hide the phone booking bar while the calendar itself is on screen.
    (function () {
      var bar = document.querySelector('[data-mobile-bar]');
      var book = document.getElementById('book');
      if (!bar || !book || !('IntersectionObserver' in window)) return;
      new IntersectionObserver(function (entries) {
        bar.classList.toggle('is-hidden', entries[0].isIntersecting);
      }).observe(book);
    })();
  </script>
</Layout>

<style>
  /* Top bar */
  .topbar {
    display: block;
    background: var(--navy-deep);
    color: var(--on-navy);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 10px;
    text-align: center;
  }
  .topbar:hover .topbar-inner > span:last-child {
    text-decoration: underline;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--gold);
    color: var(--navy-deep);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--navy-deep);
  }
  .sep {
    opacity: 0.5;
    margin-inline: 4px;
  }

  /* Header */
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 12px;
  }
  .brand img {
    height: 52px;
    width: auto;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .header-phone {
    font-weight: 600;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  /* Hero */
  .hero {
    background: linear-gradient(180deg, var(--wash) 0%, var(--white) 100%);
    padding-block: clamp(40px, 6vw, 72px) clamp(48px, 6vw, 72px);
  }
  .hero-inner {
    display: grid;
    gap: clamp(28px, 4vw, 40px);
    justify-items: center;
    text-align: center;
  }
  .hero-head {
    display: grid;
    gap: 18px;
    justify-items: center;
    max-width: 860px;
  }
  .hero h1 {
    font-size: clamp(34px, 4.8vw, 56px);
    font-weight: 700;
    color: var(--navy);
  }
  .hero-sub {
    font-size: clamp(18px, 1.9vw, 21px);
    line-height: 1.5;
    max-width: 62ch;
  }
  .player {
    width: 100%;
    max-width: 960px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--navy-deep);
    box-shadow: var(--shadow);
    border: 6px solid var(--white);
  }
  .player iframe,
  .player video {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .player-placeholder {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }
  .player-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(8, 39, 67, 0.62);
  }
  .play {
    position: relative;
    width: clamp(64px, 9vw, 92px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 10px rgba(253, 191, 96, 0.25);
  }
  .play::after {
    content: '';
    position: absolute;
    left: 54%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 14px 0 14px 22px;
    border-color: transparent transparent transparent var(--navy-deep);
  }
  .player-note {
    position: relative;
    color: var(--on-navy);
    font-weight: 600;
    font-size: 15px;
  }
  .hero-cta {
    display: grid;
    gap: 12px;
    justify-items: center;
  }
  .btn-lg {
    min-height: 64px;
    padding: 18px 36px;
    font-size: 17px;
  }

  /* Stats */
  .stats {
    background: var(--navy);
    color: var(--on-navy);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-block: 28px;
  }
  .stat {
    display: grid;
    gap: 4px;
    padding: 8px 20px;
    border-left: 1px solid rgba(255, 255, 255, 0.16);
  }
  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .stat-value {
    font-size: clamp(30px, 3.6vw, 42px);
    font-weight: 800;
    line-height: 1;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    font-size: 14px;
    color: var(--on-navy-soft);
    line-height: 1.4;
  }

  /* Next step */
  .next-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .next-copy {
    display: grid;
    gap: 18px;
    justify-items: start;
    min-width: 0;
  }
  .next-copy h2 {
    font-size: clamp(30px, 4vw, 44px);
    color: var(--navy);
  }
  .next-copy p {
    font-size: 18px;
    max-width: 52ch;
  }
  .agenda {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
    min-width: 0;
  }
  .agenda li {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
  }
  .agenda-label {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--navy);
    padding-top: 3px;
  }

  /* Inside */
  .inside {
    background: var(--wash);
  }
  .inside-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(40px, 6vw, 72px);
  }
  .inside-row {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .inside-row.flip .inside-media {
    order: 2;
  }
  .inside-media img {
    width: 100%;
    aspect-ratio: 4 / 4.2;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .inside-copy {
    display: grid;
    gap: 14px;
    min-width: 0;
  }
  .inside-num {
    font-size: clamp(56px, 7vw, 88px);
    font-weight: 800;
    line-height: 0.9;
    color: var(--gold);
    letter-spacing: -0.04em;
  }
  .inside-copy h3 {
    font-size: clamp(26px, 3vw, 34px);
    color: var(--navy);
  }
  .inside-copy > p {
    max-width: 56ch;
  }
  .checks {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .checks li {
    position: relative;
    padding-left: 32px;
    font-weight: 500;
    color: var(--ink);
  }
  .checks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--navy);
  }
  .checks li::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 7px;
    width: 5px;
    height: 9px;
    border: solid var(--gold);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .center-cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(48px, 6vw, 72px);
  }

  /* Proof */
  .proof-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 32px;
    align-items: start;
  }
  .video-card {
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .video-card video {
    width: 100%;
    aspect-ratio: 9 / 16;
    max-height: 560px;
    object-fit: cover;
    background: var(--navy-deep);
    border-radius: var(--radius-lg);
  }
  .video-card figcaption {
    font-size: 14px;
    color: var(--muted);
  }
  .quotes {
    display: grid;
    gap: 16px;
    min-width: 0;
  }
  .quote {
    margin: 0;
    padding: 24px 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    display: grid;
    gap: 16px;
  }
  .quote p {
    font-size: 18px;
    color: var(--ink);
    line-height: 1.55;
  }
  .quote footer {
    display: grid;
    font-size: 14px;
  }
  .quote footer strong {
    color: var(--navy);
  }
  .quote footer span {
    color: var(--muted);
  }

  /* Book */
  .book {
    background: var(--navy);
    color: var(--on-navy);
    padding-block: clamp(56px, 8vw, 104px);
    scroll-margin-top: 70px;
  }
  .book-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .book-copy {
    display: grid;
    gap: 18px;
    min-width: 0;
  }
  .seal {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--white);
    padding: 4px;
  }
  .eyebrow-light {
    color: var(--gold);
  }
  .book h2 {
    color: var(--on-navy);
    font-size: clamp(30px, 4vw, 44px);
  }
  .book p {
    color: var(--on-navy-soft);
    font-size: 18px;
  }
  .book p a {
    color: var(--gold);
    font-weight: 600;
  }
  .book-help {
    font-size: 16px !important;
  }
  .checks-light li {
    color: var(--on-navy);
  }
  .checks-light li::before {
    background: var(--gold);
  }
  .checks-light li::after {
    border-color: var(--navy);
  }
  .embed-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: 12px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    min-width: 0;
  }

  /* Apply */
  .apply {
    scroll-margin-top: 70px;
    border-bottom: 1px solid var(--line);
  }
  .apply-inner {
    display: grid;
    gap: 28px;
    max-width: 900px;
  }
  .apply-head {
    display: grid;
    gap: 12px;
  }
  .apply-head h2 {
    font-size: clamp(28px, 3.4vw, 38px);
    color: var(--navy);
  }
  .apply-head p {
    max-width: 64ch;
  }
  .apply-toggle {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--wash);
  }
  .apply-toggle > summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    font-weight: 700;
    color: var(--navy);
    font-size: 18px;
  }
  .apply-toggle > summary::-webkit-details-marker {
    display: none;
  }
  .apply-toggle[open] > summary .plus {
    background: var(--gold);
  }
  .apply-toggle[open] > summary .plus::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .embed-card-light {
    box-shadow: none;
    border-top: 1px solid var(--line);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }

  /* FAQ */
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .faq-intro {
    display: grid;
    gap: 16px;
    justify-items: start;
    position: sticky;
    top: 100px;
  }
  .faq-intro h2 {
    font-size: clamp(30px, 4vw, 42px);
  }
  .faq {
    min-width: 0;
    border-top: 1px solid var(--line);
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
  }
  .faq-item summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 20px;
    cursor: pointer;
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--wash);
  }
  .apply-toggle .plus {
    background: var(--white);
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    background: var(--navy);
    transform: translate(-50%, -50%);
    transition: transform 0.25s ease;
  }
  .plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .faq-item[open] .plus {
    background: var(--gold);
  }
  .faq-item[open] .plus::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .faq-item p {
    padding-bottom: 20px;
    max-width: 60ch;
  }

  /* Footer */
  .site-footer {
    background: var(--navy-deep);
    color: var(--on-navy-soft);
    padding-block: 56px 32px;
    font-size: 15px;
  }
  .site-footer a {
    color: var(--on-navy);
    text-decoration: none;
  }
  .site-footer a:hover {
    text-decoration: underline;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 32px;
  }
  .footer-brand {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .footer-brand img {
    width: 220px;
    height: auto;
  }
  .footer-brand p {
    color: var(--on-navy-soft);
    max-width: 36ch;
  }
  .footer-links,
  .footer-contact {
    display: grid;
    gap: 8px;
    align-content: start;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .footer-head {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 4px;
  }
  .footer-legal {
    display: grid;
    gap: 12px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .footer-legal p {
    color: var(--on-navy-soft);
    font-size: 13px;
    max-width: 90ch;
  }

  /* Mobile booking bar */
  .mobile-bar {
    display: none;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .next-grid,
    .proof-grid,
    .book-grid,
    .faq-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 20px;
    }
    .stat:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .video-card video {
      max-height: 480px;
    }
    .faq-intro {
      position: static;
    }
    .footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 720px) {
    .inside-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .inside-row.flip .inside-media {
      order: 0;
    }
    .inside-media img {
      aspect-ratio: 4 / 3;
    }
    .header-phone {
      display: none;
    }
    .player {
      border-width: 3px;
    }
    .agenda li {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
    .mobile-bar {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 30;
      padding: 10px max(16px, env(safe-area-inset-right, 0px)) calc(10px + env(safe-area-inset-bottom, 0px))
        max(16px, env(safe-area-inset-left, 0px));
      background: rgba(255, 255, 255, 0.97);
      border-top: 1px solid var(--line);
      box-shadow: 0 -6px 20px rgba(11, 52, 91, 0.1);
      transition: transform 0.3s ease;
    }
    .mobile-bar .btn {
      width: 100%;
      min-height: 52px;
    }
    .mobile-bar.is-hidden {
      transform: translateY(110%);
    }
    .site-footer {
      padding-bottom: 104px;
    }
  }
  @media (max-width: 520px) {
    .brand img {
      height: 40px;
    }
    .btn {
      width: 100%;
    }
    .site-header .btn {
      width: auto;
    }
    .footer-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Watch: player + chapters */
  .watch {
    width: 100%;
    max-width: 960px;
    display: grid;
    gap: 16px;
    justify-items: center;
  }
  .player-file {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .player-file video {
    object-fit: contain;
    background: #000;
  }
  .cover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(18px, 4vw, 40px);
    border: 0;
    background: var(--navy-deep);
    cursor: pointer;
    font: inherit;
    text-align: left;
    overflow: hidden;
  }
  .cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .cover::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(8, 39, 67, 0.94) 0%, rgba(8, 39, 67, 0.78) 45%, rgba(8, 39, 67, 0.25) 100%);
    z-index: 1;
  }
  .cover:hover img {
    transform: scale(1.03);
  }
  .cover-text,
  .cover .play {
    position: relative;
    z-index: 2;
  }
  .cover-text {
    display: grid;
    gap: 10px;
    max-width: 480px;
  }
  .cover-eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .cover-title {
    font-size: clamp(22px, 3.4vw, 38px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--white);
    text-wrap: balance;
  }
  .cover-meta {
    font-size: 15px;
    color: var(--on-navy-soft);
  }
  .cover .play {
    flex: none;
    transition: transform 0.25s ease;
  }
  .cover:hover .play {
    transform: scale(1.06);
  }
  .chapters {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 12px;
  }
  .chapters-head {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .chapters ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .chapters button {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    line-height: 1.3;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .chapters button:hover {
    border-color: var(--navy);
  }
  .chapters button.is-current {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--white);
  }
  .chapters button.is-current .chapter-time {
    color: var(--gold);
  }
  .chapter-time {
    color: var(--navy);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    margin-right: 2px;
  }

  /* Who + why */
  .audience {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .audience li {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 24px;
    border-top: 4px solid var(--gold);
    background: var(--wash);
    border-radius: 0 0 var(--radius) var(--radius);
  }
  .audience h3 {
    font-size: 21px;
    color: var(--navy);
  }
  .why {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-top: clamp(40px, 6vw, 72px);
    padding-top: clamp(32px, 5vw, 56px);
    border-top: 1px solid var(--line);
  }
  .why-head {
    display: grid;
    gap: 10px;
  }
  .why-head h3 {
    font-size: clamp(24px, 2.8vw, 32px);
    color: var(--navy);
  }
  .why-stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .why-stat {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .why-stat dt {
    font-size: clamp(36px, 4.4vw, 52px);
    font-weight: 800;
    line-height: 1;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
  }
  .why-stat dd {
    margin: 0;
    display: grid;
    gap: 6px;
    color: var(--body);
    font-size: 15px;
    line-height: 1.45;
  }
  .why-src {
    font-size: 12px;
    color: var(--muted);
  }

  /* Certifications */
  .certs {
    background: var(--navy);
    color: var(--on-navy);
  }
  .certs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .certs-head {
    display: grid;
    gap: 18px;
    justify-items: start;
