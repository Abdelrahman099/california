  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--navy-deep);
  }
  .sep {
    opacity: 0.5;
    margin-inline: 4px;
  }

  /* Header */
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 12px;
  }
  .brand img {
    height: 52px;
    width: auto;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .header-phone {
    font-weight: 600;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  /* Hero */
  .hero {
    background: linear-gradient(180deg, var(--wash) 0%, var(--white) 100%);
    padding-block: clamp(40px, 6vw, 72px) clamp(48px, 6vw, 72px);
  }
  .hero-inner {
    display: grid;
    gap: clamp(28px, 4vw, 40px);
    justify-items: center;
    text-align: center;
  }
  .hero-head {
    display: grid;
    gap: 18px;
    justify-items: center;
    max-width: 860px;
  }
  .hero h1 {
    position: relative;
    isolation: isolate;
    font-size: clamp(36px, 5.2vw, 62px);
    font-weight: 700;
    color: var(--navy);
  }
  .h1-line {
    display: block;
  }
  .h1-sep {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .h1-accent {
    position: relative;
    justify-self: center;
    width: fit-content;
    margin-inline: auto;
  }
  .h1-accent::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.02em;
    height: 0.14em;
    background: var(--gold);
    border-radius: 999px;
    z-index: -1;
  }
  .hero-sub {
    font-size: clamp(18px, 1.9vw, 21px);
    line-height: 1.5;
    max-width: 62ch;
  }
  .player {
    width: 100%;
    max-width: 960px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--navy-deep);
    box-shadow: var(--shadow);
    border: 6px solid var(--white);
  }
  .player iframe,
  .player video {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .player-placeholder {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }
  .player-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(8, 39, 67, 0.62);
  }
  .play {
    position: relative;
    width: clamp(64px, 9vw, 92px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 10px rgba(253, 191, 96, 0.25);
  }
  .play::after {
    content: '';
    position: absolute;
    left: 54%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 14px 0 14px 22px;
    border-color: transparent transparent transparent var(--navy-deep);
  }
  .player-note {
    position: relative;
    color: var(--on-navy);
    font-weight: 600;
    font-size: 15px;
  }
  .hero-cta {
    display: grid;
    gap: 12px;
    justify-items: center;
  }
  .btn-lg {
    min-height: 64px;
    padding: 18px 36px;
    font-size: 17px;
  }

  /* Stats */
  .stats {
    background: var(--navy);
    color: var(--on-navy);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-block: 28px;
  }
  .stat {
    display: grid;
    gap: 4px;
    padding: 8px 20px;
    border-left: 1px solid rgba(255, 255, 255, 0.16);
  }
  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .stat-value {
    font-size: clamp(30px, 3.6vw, 42px);
    font-weight: 800;
    line-height: 1;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    font-size: 14px;
    color: var(--on-navy-soft);
    line-height: 1.4;
  }

  /* Next step */
  .next-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .next-copy {
    display: grid;
    gap: 18px;
    justify-items: start;
    min-width: 0;
  }
  .next-copy h2 {
    font-size: clamp(30px, 4vw, 44px);
    color: var(--navy);
  }
  .next-copy p {
    font-size: 18px;
    max-width: 52ch;
  }
  .agenda {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
    min-width: 0;
  }
  .agenda li {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
  }
  .agenda-label {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--navy);
    padding-top: 3px;
  }

  /* Inside */
  .inside {
    background: var(--wash);
  }
  .inside-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(40px, 6vw, 72px);
  }
  .inside-row {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .inside-row.flip .inside-media {
    order: 2;
  }
  .inside-media img {
    width: 100%;
    aspect-ratio: 4 / 4.2;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .inside-copy {
    display: grid;
    gap: 14px;
    min-width: 0;
  }
  .inside-num {
    font-size: clamp(56px, 7vw, 88px);
    font-weight: 800;
    line-height: 0.9;
    color: var(--gold);
    letter-spacing: -0.04em;
  }
  .inside-copy h3 {
    font-size: clamp(26px, 3vw, 34px);
    color: var(--navy);
  }
  .inside-copy > p {
    max-width: 56ch;
  }
  .checks {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .checks li {
    position: relative;
    padding-left: 32px;
    font-weight: 500;
    color: var(--ink);
  }
  .checks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--navy);
  }
  .checks li::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 7px;
    width: 5px;
    height: 9px;
    border: solid var(--gold);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .center-cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(48px, 6vw, 72px);
  }

  /* Hands-on locations */
  .locations { background: var(--white); scroll-margin-top: 70px; }
  /* The section keeps a title for screen readers and search, without showing it. */
  .loc-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .loc-band { padding-top: 24px; background: var(--navy-deep); }
  .loc-list { margin: 0; padding: 0; list-style: none; }
  .loc-list li { display: flex; justify-content: space-between; align-items: center; gap: 32px; min-height: 96px; padding-block: 12px; padding-inline: max(16px, env(safe-area-inset-left, 0px), calc((100vw - 1160px) / 2)); }
  .loc-list li + li { border-top: 1px solid rgba(195,208,222,.28); }
  .loc-list h3 { margin: 0; color: #fff; font-size: clamp(26px, 3.4vw, 42px); line-height: 1.15; font-weight: 600; letter-spacing: -.02em; }
  .loc-list p { margin: 0; color: var(--on-navy-soft); font-size: 16px; line-height: 1.4; text-align: right; }
  .loc-foot { display: flex; justify-content: space-between; align-items: center; gap: 40px; padding-block: 36px 56px; }
  .loc-foot p { max-width: 72ch; margin: 0; color: var(--on-navy-soft); font-size: 15px; line-height: 1.55; }
  .loc-foot strong { color: #fff; font-weight: 600; }
  .loc-foot .btn { flex: none; white-space: nowrap; padding-inline: 24px; font-size: 14px; }
  @media (max-width: 860px) {
    .loc-list li { flex-direction: column; align-items: flex-start; justify-content: center; gap: 2px; min-height: 84px; }
    .loc-list h3 { font-size: 22px; }
    .loc-list p { font-size: 14px; text-align: left; }
    .loc-foot { flex-direction: column; align-items: stretch; gap: 20px; padding-block: 28px 44px; }
    .loc-foot .btn { white-space: normal; }
  }

  /* Ana video */
  .ana { background: var(--wash); }
  .ana-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: center; }
  .ana-copy { display: grid; gap: 18px; justify-items: start; }
  .video-card { margin: 0; }
  .video-card video {
    width: 100%; aspect-ratio: 16 / 11; object-fit: cover;
    background: var(--navy-deep); border-radius: var(--radius-lg);
  }
  @media (max-width: 900px) { .ana-grid { grid-template-columns: minmax(0, 1fr); gap: 24px; } }

  /* Book */
  .book {
    background: var(--navy);
    color: var(--on-navy);
    padding-block: clamp(56px, 8vw, 104px);
    scroll-margin-top: 70px;
  }
  .book-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .book-copy {
    display: grid;
    gap: 18px;
    min-width: 0;
  }
  .seal {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--white);
    padding: 4px;
  }
  .eyebrow-light {
    color: var(--gold);
  }
  .book h2 {
    color: var(--on-navy);
    font-size: clamp(30px, 4vw, 44px);
  }
  .book p {
    color: var(--on-navy-soft);
    font-size: 18px;
  }
  .book p a {
    color: var(--gold);
    font-weight: 600;
  }
  .book-help {
    font-size: 16px !important;
  }
  .checks-light li {
    color: var(--on-navy);
  }
  .checks-light li::before {
    background: var(--gold);
  }
  .checks-light li::after {
    border-color: var(--navy);
  }
  .embed-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: 12px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    min-width: 0;
  }

  /* FAQ */
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .faq-intro {
    display: grid;
    gap: 16px;
    justify-items: start;
    position: sticky;
    top: 100px;
  }
  .faq-intro h2 {
    font-size: clamp(30px, 4vw, 42px);
  }
  .faq {
    min-width: 0;
    border-top: 1px solid var(--line);
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
  }
  .faq-item summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 20px;
    cursor: pointer;
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--wash);
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    background: var(--navy);
    transform: translate(-50%, -50%);
    transition: transform 0.25s ease;
  }
  .plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .faq-item[open] .plus {
    background: var(--gold);
  }
  .faq-item[open] .plus::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .faq-item p {
    padding-bottom: 20px;
    max-width: 60ch;
  }

  /* Footer */
  .site-footer {
    background: var(--navy-deep);
    color: var(--on-navy-soft);
    padding-block: 56px 32px;
    font-size: 15px;
  }
  .site-footer a {
    color: var(--on-navy);
    text-decoration: none;
  }
  .site-footer a:hover {
    text-decoration: underline;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 32px;
  }
  .footer-brand {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    text-decoration: none !important;
  }
  .footer-logo img {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--white);
    padding: 3px;
  }
  .footer-wordmark {
    display: grid;
    line-height: 1.15;
    color: var(--on-navy);
    text-transform: uppercase;
  }
  .footer-wordmark strong {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .footer-wordmark span {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--on-navy-soft);
  }
  .footer-brand p {
    color: var(--on-navy-soft);
    max-width: 36ch;
  }
  .footer-links,
  .footer-contact {
    display: grid;
    gap: 8px;
    align-content: start;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .footer-head {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 4px;
  }
  .footer-legal {
    display: grid;
    gap: 12px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .footer-legal p {
    color: var(--on-navy-soft);
    font-size: 13px;
    max-width: 90ch;
  }

  /* Mobile booking bar */
  .mobile-bar {
    display: none;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .next-grid,
    .book-grid,
    .faq-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 20px;
    }
    .stat:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .video-card video {
      max-height: 480px;
    }
    .faq-intro {
      position: static;
    }
    .footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 720px) {
    .inside-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .inside-row.flip .inside-media {
      order: 0;
    }
    .inside-media img {
      aspect-ratio: 4 / 3;
    }
    .header-phone {
      display: none;
    }
    .player {
      border-width: 3px;
    }
    .agenda li {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
    .mobile-bar {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 30;
      padding: 8px max(16px, env(safe-area-inset-right, 0px)) calc(8px + env(safe-area-inset-bottom, 0px))
        max(16px, env(safe-area-inset-left, 0px));
      background: rgba(255, 255, 255, 0.97);
      border-top: 1px solid var(--line);
      box-shadow: 0 -6px 20px rgba(11, 52, 91, 0.1);
      transition: transform 0.3s ease;
    }
    .mobile-bar .btn {
      width: 100%;
      min-height: 44px;
      padding: 10px 12px;
      font-size: 13px;
      letter-spacing: 0.06em;
      white-space: nowrap;
    }
    .mobile-bar.is-hidden {
      transform: translateY(110%);
    }
    .site-footer {
      padding-bottom: 104px;
    }
  }
  @media (max-width: 520px) {
    .header-inner {
      padding-block: 8px;
    }
    .brand img {
      height: 46px;
    }
    .btn {
      width: 100%;
    }
    .site-header .btn {
      position: relative;
      width: auto;
      min-height: 30px;
      padding: 6px 11px;
      font-size: 9.5px;
      letter-spacing: 0.05em;
      white-space: nowrap;
    }
    /* Smaller button, same 46px tap area */
    .site-header .btn::after {
      content: '';
      position: absolute;
      inset: -8px 0;
    }
    .footer-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 360px) {
    .brand img {
      height: 40px;
    }
    .site-header .btn {
      padding-inline: 9px;
      font-size: 9px;
    }
  }
  @media (max-width: 340px) {
    .mobile-bar .btn {
      font-size: 11.5px;
      letter-spacing: 0.04em;
    }
  }
  /* Watch: player + chapters */
  .watch {
    width: 100%;
    max-width: 960px;
    display: grid;
    gap: 16px;
    justify-items: center;
  }
  .player-file {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .player-file video {
    object-fit: contain;
    background: #000;
  }
  .cover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(18px, 4vw, 40px);
    border: 0;
    background: var(--navy-deep);
    cursor: pointer;
    font: inherit;
    text-align: left;
    overflow: hidden;
  }
  .cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .cover::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(8, 39, 67, 0.94) 0%, rgba(8, 39, 67, 0.78) 45%, rgba(8, 39, 67, 0.25) 100%);
    z-index: 1;
  }
  .cover:hover img {
    transform: scale(1.03);
  }
  .cover-text,
  .cover .play {
    position: relative;
    z-index: 2;
  }
  .cover-text {
    display: grid;
    gap: 10px;
    max-width: 480px;
  }
  .cover-eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .cover-title {
    font-size: clamp(22px, 3.4vw, 38px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--white);
    text-wrap: balance;
  }
  .cover-meta {
    font-size: 15px;
    color: var(--on-navy-soft);
  }
  .cover .play {
    flex: none;
    transition: transform 0.25s ease;
  }
  .cover:hover .play {
    transform: scale(1.06);
  }
  .chapters {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 12px;
  }
  .chapters-head {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .chapters ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .chapters button {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    line-height: 1.3;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .chapters button:hover {
    border-color: var(--navy);
  }
  .chapters button.is-current {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--white);
  }
  .chapters button.is-current .chapter-time {
    color: var(--gold);
  }
  .chapter-time {
    color: var(--navy);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    margin-right: 2px;
  }

  /* Who + why */
  .audience {
    list-style: none;
    margin: 0;
    padding: 0;
