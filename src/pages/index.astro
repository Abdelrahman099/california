---
import Layout from '../layouts/Layout.astro';
import {
  asset,
  videoEmbed,
  PREVIEW_VIDEO_URL,
  BOOKING_URL,
  APPLICATION_URL,
  GHL_EMBED_SCRIPT,
  MAIN_SITE,
  PHONE,
  PHONE_HREF,
  EMAIL,
  ADDRESS,
} from '../config';

const video = videoEmbed(PREVIEW_VIDEO_URL);
const BOOK_LABEL = 'Book my admissions appointment';

const stats = [
  { value: '200+', label: 'Satisfied students across the state' },
  { value: '99%', label: 'Course completion success rate' },
  { value: '25+', label: 'Training locations in California' },
  { value: '100+', label: 'Partnered dental clinics' },
];

const appointment = [
  {
    label: 'Your goals',
    text: 'Tell your advisor where you are now and where you want to be. They’ll check that the program fits your schedule and timeline.',
  },
  {
    label: 'Your plan',
    text: 'Pick the track and training location near you, and set a realistic start date and finish date.',
  },
  {
    label: 'Your cost',
    text: 'Get your exact tuition, plus 0% financing, payment plans and any scholarships you qualify for.',
  },
  {
    label: 'Your next step',
    text: 'Leave knowing exactly how to enroll. If you’re ready, your advisor can help you complete your application on the spot.',
  },
];

const inside = [
  {
    n: '#1',
    title: 'How the program works',
    body: 'The self-paced, hybrid format up close: 300+ course hours that mix online lessons with hands-on clinical training. You get 12 months of access, and most students finish in 8 to 15 weeks.',
    points: ['Online coursework you do on your schedule', 'Hands-on clinical training near you', '40+ instructors, including dentists and RDAs'],
    img: 'images/learn-xray.jpg',
    alt: 'A CDA Program student practicing dental X-ray positioning on a classmate.',
  },
  {
    n: '#2',
    title: 'Your path to getting hired',
    body: 'How students move from coursework into real dental offices, and how our job placement team helps you land your first role after you finish.',
    points: ['Resume writing and interview prep', 'Connections with 100+ partnered dental clinics', 'A 1-on-1 dental buddy while you train'],
    img: 'images/learn-chairside.jpg',
    alt: 'A student in protective gear working chairside at a dental operatory.',
  },
  {
    n: '#3',
    title: 'What it costs and how to pay',
    body: 'An overview of tuition and the ways students make it fit their budget. Your admissions advisor gives you your exact numbers during your appointment.',
    points: ['0% tuition financing', 'Monthly scholarships and student grants', 'Flexible payment plans'],
    img: 'images/learn-graduate.jpg',
    alt: 'A CDA Program graduate in scrubs ready for her first dental job.',
  },
];

const quotes = [
  {
    text: 'The program has modern equipment and helps with job placement. I highly recommend this program to anyone who wants to be a dental assistant!',
    name: 'Yadira Martinez',
    role: 'Dental Assisting Program Student',
  },
  {
    text: 'If you’re looking to accelerate your career as a dental assistant, this should be your one and only choice.',
    name: 'Jessica P.',
    role: 'Alumni Student',
  },
  {
    text: 'If you’re on the fence about joining, let this comment be the nudge you need. You won’t regret it.',
    name: 'Osamah Al Janabi',
    role: 'Dental Assistant Program Student',
  },
];

const faqs = [
  {
    q: 'What is the Initial Student Admissions Appointment?',
    a: 'A free 1-on-1 call with a CDA Program admissions advisor. You’ll go over your goals, your schedule, your training location, your tuition and financing options, and how to enroll.',
  },
  {
    q: 'Does booking the appointment commit me to enrolling?',
    a: 'No. The appointment is free and there’s no obligation. It’s how you get your personal plan and exact pricing before you decide.',
  },
  {
    q: 'Should I apply before my appointment?',
    a: 'You don’t have to. Most students book the appointment first and their advisor walks them through the application. If you’re already sure, you can submit your application on this page and your advisor will review it with you.',
  },
  {
    q: 'When can I start the program?',
    a: 'Enrollment is open, so you can start whenever you’re ready. Access to your course takes 24 to 48 business hours after you register.',
  },
  {
    q: 'How long does the program take?',
    a: 'You get 12 months to complete the program. Because it’s self-paced, most students finish in 8 to 15 weeks.',
  },
  {
    q: 'How much does the program cost?',
    a: 'Cost depends on your course track and whether you qualify for financial aid. We offer 0% tuition financing, payment plans and scholarships. Your admissions advisor will give you exact pricing.',
  },
  {
    q: 'Is CPR certification included?',
    a: 'Yes. CPR certification is part of the program, with classes that follow American Heart Association (AHA) guidelines.',
  },
  {
    q: 'Will you help me find a job?',
    a: 'Yes. Graduates get job placement assistance, including resume support, interview preparation and connections to local dental practices that are hiring.',
  },
];

const title = 'Virtual Preview | California Dental Assistant Program';
const description =
  'Watch the free Virtual Preview of the California Dental Assistant Program, then book your Initial Student Admissions Appointment.';
---

<Layout title={title} description={description}>
  <!-- Top bar -->
  <a class="topbar" href="#book">
    <span class="wrap topbar-inner">
      <span class="badge"><span class="dot" aria-hidden="true"></span>Free</span>
      <span>Virtual Preview <span class="sep">|</span> Watch, then book your admissions appointment</span>
    </span>
  </a>

  <!-- Header -->
  <header class="site-header">
    <div class="wrap header-inner">
      <a href={MAIN_SITE} class="brand" aria-label="California Dental Assistant Program home">
        <img src={asset('images/logo-lockup.png')} alt="California Dental Assistant Program" width="276" height="86" />
      </a>
      <div class="header-actions">
        <a href={PHONE_HREF} class="header-phone">{PHONE}</a>
        <a href="#book" class="btn btn-gold btn-sm">Book appointment</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- Hero: the Virtual Preview -->
    <section class="hero">
      <div class="wrap hero-inner">
        <div class="hero-head">
          <span class="eyebrow">Dental Assistant Program · Virtual Preview</span>
          <h1>Is a dental career the change you’ve been waiting for?</h1>
          <p class="hero-sub">
            Watch this free preview to see how you could be working in a dental office in as little as 8 to 15 weeks.
            Then book your admissions appointment to get your personal plan.
          </p>
        </div>

        <div class="player" id="preview">
          {video?.kind === 'iframe' && (
            <iframe
              src={video.src}
              title="CDA Program Virtual Preview"
              allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
              allowfullscreen
            ></iframe>
          )}
          {video?.kind === 'file' && (
            <video controls playsinline preload="metadata" poster={asset('images/hero-clinic.jpg')}>
              <source src={video.src} />
            </video>
          )}
          {!video && (
            <div class="player-placeholder" style={`background-image:url(${asset('images/hero-clinic.jpg')})`}>
              <span class="play" aria-hidden="true"></span>
              <span class="player-note">Virtual Preview recording goes here</span>
            </div>
          )}
        </div>

        <div class="hero-cta">
          <a href="#book" class="btn btn-gold btn-lg">{BOOK_LABEL} <span class="arrow" aria-hidden="true">→</span></a>
          <span class="cta-note">Free 1-on-1 call with an admissions advisor · No obligation</span>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="stats" aria-label="Program results">
      <div class="wrap stats-grid">
        {stats.map((s) => (
          <div class="stat">
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Next step: the appointment -->
    <section class="section next">
      <div class="wrap next-grid">
        <div class="next-copy">
          <span class="eyebrow">Your next step</span>
          <h2>Book your Initial Student Admissions Appointment</h2>
          <p>
            The preview shows you how the program works. Your appointment turns it into a plan for you. In one free call,
            an admissions advisor will cover:
          </p>
          <a href="#book" class="btn btn-gold">{BOOK_LABEL} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <ol class="agenda">
          {appointment.map((a) => (
            <li>
              <span class="agenda-label">{a.label}</span>
              <p>{a.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Inside the preview -->
    <section class="section inside">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Inside the preview</span>
          <h2>Three things you’ll learn in the preview</h2>
          <p>It follows the same path a new student does, from first lesson to first paycheck.</p>
        </div>
        <ol class="inside-list">
          {inside.map((item, i) => (
            <li class={`inside-row ${i % 2 ? 'flip' : ''}`}>
              <div class="inside-media">
                <img src={asset(item.img)} alt={item.alt} loading="lazy" width="900" height="1273" />
              </div>
              <div class="inside-copy">
                <span class="inside-num">{item.n}</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                <ul class="checks">
                  {item.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
        <div class="center-cta">
          <a href="#book" class="btn btn-gold">{BOOK_LABEL} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- Social proof -->
    <section class="section proof">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Student stories</span>
          <h2>What people are saying</h2>
        </div>
        <div class="proof-grid">
          <figure class="video-card">
            <video
              controls
              preload="none"
              playsinline
              poster={asset('videos/testimonial-poster.jpg')}
              aria-label="Dental assistant student testimonial video"
            >
              <source src={asset('videos/testimonial.mp4')} type="video/mp4" />
            </video>
            <figcaption>A CDA Program student on her experience</figcaption>
          </figure>
          <div class="quotes">
            {quotes.map((q) => (
              <blockquote class="quote">
                <p>“{q.text}”</p>
                <footer>
                  <strong>{q.name}</strong>
                  <span>{q.role}</span>
                </footer>
              </blockquote>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Book (primary) -->
    <section class="book" id="book">
      <div class="wrap book-grid">
        <div class="book-copy">
          <img class="seal" src={asset('images/logo-seal.png')} alt="" width="120" height="120" />
          <span class="eyebrow eyebrow-light">Initial Student Admissions Appointment</span>
          <h2>Pick a time that works for you</h2>
          <p>Choose a day and time below. Your admissions advisor will call you at your appointment time.</p>
          <ul class="checks checks-light">
            <li>Free 1-on-1 call, no obligation</li>
            <li>Your personal start date and training location</li>
            <li>Your exact tuition and financing options</li>
          </ul>
          <p class="book-help">Can’t find a time that works? Call us at <a href={PHONE_HREF}>{PHONE}</a>.</p>
        </div>
        <div class="embed-card" data-embed="booking">
          <iframe
            src={BOOKING_URL}
            title="Book your Initial Student Admissions Appointment"
            scrolling="no"
            id="booking-calendar"
            style="width:100%;min-height:720px;border:none;overflow:hidden"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- Apply (secondary) -->
    <section class="section apply" id="apply">
      <div class="wrap apply-inner">
        <div class="apply-head">
          <span class="eyebrow">Already decided?</span>
          <h2>Start your student application</h2>
          <p>
            If you already know you want to enroll, you can submit your application now. Please still book your admissions
            appointment above so your advisor can review it with you and confirm your start date.
          </p>
        </div>
        <details class="apply-toggle" id="apply-form">
          <summary>
            <span>Open the student application</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div class="embed-card embed-card-light" data-embed="application">
            <iframe
              src={APPLICATION_URL}
              title="CDA Program Student Application"
              scrolling="no"
              id="student-application"
              style="width:100%;min-height:900px;border:none;overflow:hidden"
            ></iframe>
          </div>
        </details>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section faq-section">
      <div class="wrap faq-grid">
        <div class="faq-intro">
          <span class="eyebrow">Questions</span>
          <h2>Frequently asked questions</h2>
          <p>Still have a question? Your admissions advisor can answer it during your appointment.</p>
          <a href="#book" class="btn btn-gold">{BOOK_LABEL} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="faq">
          {faqs.map((f, i) => (
            <details class="faq-item" id={`faq-${i + 1}`} open={i === 0}>
              <summary>
                <span>{f.q}</span>
                <span class="plus" aria-hidden="true"></span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div class="footer-brand">
        <img src={asset('images/logo-lockup-white.png')} alt="California Dental Assistant Program" width="220" height="69" />
        <p>Dental Board of California–approved continuing education provider.</p>
      </div>
      <nav class="footer-links" aria-label="Program">
        <span class="footer-head">Program</span>
        <a href={`${MAIN_SITE}/courses`}>Courses</a>
        <a href={`${MAIN_SITE}/financial-aid`}>Financial aid</a>
        <a href={`${MAIN_SITE}/faq`}>FAQ</a>
        <a href={`${MAIN_SITE}/contact-us`}>Contact us</a>
      </nav>
      <div class="footer-contact">
        <span class="footer-head">Contact</span>
        <a href={PHONE_HREF}>{PHONE}</a>
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <span>{ADDRESS}</span>
      </div>
    </div>
    <div class="wrap footer-legal">
      <p>
        Results described on this page are not typical and are not guaranteed. Completion times, job placement and outcomes
        depend on each student’s effort, schedule and local job market. Program details are subject to change.
      </p>
      <p>
        © 2026 California Dental Assistant Program ·
        <a href={`${MAIN_SITE}/privacy-policy`}>Privacy Policy</a> ·
        <a href={`${MAIN_SITE}/terms-and-conditions`}>Terms and Conditions</a>
      </p>
    </div>
  </footer>

  <!-- Sticky booking bar on phones -->
  <div class="mobile-bar" data-mobile-bar>
    <a href="#book" class="btn btn-gold">{BOOK_LABEL}</a>
  </div>

  <script is:inline src={GHL_EMBED_SCRIPT}></script>
  <script is:inline>
    // Hide the phone booking bar while the calendar itself is on screen.
    (function () {
      var bar = document.querySelector('[data-mobile-bar]');
      var book = document.getElementById('book');
      if (!bar || !book || !('IntersectionObserver' in window)) return;
      new IntersectionObserver(function (entries) {
        bar.classList.toggle('is-hidden', entries[0].isIntersecting);
      }).observe(book);
    })();
  </script>
</Layout>

<style>
  /* Top bar */
  .topbar {
    display: block;
    background: var(--navy-deep);
    color: var(--on-navy);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-block: 10px;
    text-align: center;
  }
  .topbar:hover .topbar-inner > span:last-child {
    text-decoration: underline;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--gold);
    color: var(--navy-deep);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--navy-deep);
  }
  .sep {
    opacity: 0.5;
    margin-inline: 4px;
  }

  /* Header */
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 12px;
  }
  .brand img {
    height: 52px;
    width: auto;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .header-phone {
    font-weight: 600;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  /* Hero */
  .hero {
    background: linear-gradient(180deg, var(--wash) 0%, var(--white) 100%);
    padding-block: clamp(40px, 6vw, 72px) clamp(48px, 6vw, 72px);
  }
  .hero-inner {
    display: grid;
    gap: clamp(28px, 4vw, 40px);
    justify-items: center;
    text-align: center;
  }
  .hero-head {
    display: grid;
    gap: 18px;
    justify-items: center;
    max-width: 860px;
  }
  .hero h1 {
    font-size: clamp(36px, 5.4vw, 62px);
    font-weight: 800;
    color: var(--navy);
  }
  .hero-sub {
    font-size: clamp(18px, 1.9vw, 21px);
    line-height: 1.5;
    max-width: 62ch;
  }
  .player {
    width: 100%;
    max-width: 960px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--navy-deep);
    box-shadow: var(--shadow);
    border: 6px solid var(--white);
  }
  .player iframe,
  .player video {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .player-placeholder {
    position: relative;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }
  .player-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(8, 39, 67, 0.62);
  }
  .play {
    position: relative;
    width: clamp(64px, 9vw, 92px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 10px rgba(253, 191, 96, 0.25);
  }
  .play::after {
    content: '';
    position: absolute;
    left: 54%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 14px 0 14px 22px;
    border-color: transparent transparent transparent var(--navy-deep);
  }
  .player-note {
    position: relative;
    color: var(--on-navy);
    font-weight: 600;
    font-size: 15px;
  }
  .hero-cta {
    display: grid;
    gap: 12px;
    justify-items: center;
  }
  .btn-lg {
    min-height: 64px;
    padding: 18px 36px;
    font-size: 17px;
  }

  /* Stats */
  .stats {
    background: var(--navy);
    color: var(--on-navy);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-block: 28px;
  }
  .stat {
    display: grid;
    gap: 4px;
    padding: 8px 20px;
    border-left: 1px solid rgba(255, 255, 255, 0.16);
  }
  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .stat-value {
    font-size: clamp(30px, 3.6vw, 42px);
    font-weight: 800;
    line-height: 1;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    font-size: 14px;
    color: var(--on-navy-soft);
    line-height: 1.4;
  }

  /* Next step */
  .next-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .next-copy {
    display: grid;
    gap: 18px;
    justify-items: start;
    min-width: 0;
  }
  .next-copy h2 {
    font-size: clamp(30px, 4vw, 44px);
    color: var(--navy);
  }
  .next-copy p {
    font-size: 18px;
    max-width: 52ch;
  }
  .agenda {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
    min-width: 0;
  }
  .agenda li {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
  }
  .agenda-label {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--navy);
    padding-top: 3px;
  }

  /* Inside */
  .inside {
    background: var(--wash);
  }
  .inside-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(40px, 6vw, 72px);
  }
  .inside-row {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .inside-row.flip .inside-media {
    order: 2;
  }
  .inside-media img {
    width: 100%;
    aspect-ratio: 4 / 4.2;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .inside-copy {
    display: grid;
    gap: 14px;
    min-width: 0;
  }
  .inside-num {
    font-size: clamp(56px, 7vw, 88px);
    font-weight: 800;
    line-height: 0.9;
    color: var(--gold);
    letter-spacing: -0.04em;
  }
  .inside-copy h3 {
    font-size: clamp(26px, 3vw, 34px);
    color: var(--navy);
  }
  .inside-copy > p {
    max-width: 56ch;
  }
  .checks {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .checks li {
    position: relative;
    padding-left: 32px;
    font-weight: 500;
    color: var(--ink);
  }
  .checks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--navy);
  }
  .checks li::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 7px;
    width: 5px;
    height: 9px;
    border: solid var(--gold);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .center-cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(48px, 6vw, 72px);
  }

  /* Proof */
