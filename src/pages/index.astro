---
import Layout from '../layouts/Layout.astro';
import {
  asset,
  videoEmbed,
  PREVIEW_VIDEO_URL,
  PREVIEW_VIDEO_CAPTIONS,
  PREVIEW_VIDEO_STREAM,
  BOOKING_URL,
  GHL_EMBED_SCRIPT,
  MAIN_SITE,
  PHONE,
  PHONE_HREF,
  EMAIL,
  ADDRESS,
} from '../config';

const video = videoEmbed(PREVIEW_VIDEO_URL);
const BOOK_LABEL = 'Book my admissions appointment';
const LICENSE = '6085';

// Chapters of the Virtual Preview recording (seconds from the start).
const chapters = [
  { t: 0, time: '0:00', label: 'Welcome and Dental Board approval' },
  { t: 46, time: '0:46', label: 'Who the program is for' },
  { t: 69, time: '1:09', label: 'Why dentistry, why now' },
  { t: 139, time: '2:19', label: 'The 8 certifications you earn' },
  { t: 168, time: '2:48', label: 'How the program works' },
  { t: 286, time: '4:46', label: 'Student Success team' },
  { t: 327, time: '5:27', label: 'Community and student portal' },
  { t: 430, time: '7:10', label: 'Tuition' },
  { t: 465, time: '7:45', label: 'Next steps' },
];

const stats = [
  { value: '8', label: 'Certifications and licenses included' },
  { value: '300', label: 'Hours of self-paced online learning' },
  { value: '3', label: 'Hands-on clinical days with licensed instructors' },
  { value: '240', label: 'Internship hours in a real dental office' },
];

const appointment = [
  {
    label: 'Your goals',
    text: 'Tell your advisor where you are now and where you want to be. They’ll check that the program fits your schedule.',
  },
  {
    label: 'Your applications',
    text: 'Your advisor walks you through your student application and scholarship application so you can get them started.',
  },
  {
    label: 'Your tuition',
    text: 'Go over tuition and any scholarships you qualify for, so you know your final cost before you commit.',
  },
  {
    label: 'Your start date',
    text: 'Pick when you start. You can enroll as soon as the next day, depending on advisor availability.',
  },
];

const audience = [
  {
    title: 'Pre-dental students',
    text: 'Heading toward dental hygiene or dental school? Get real chairside experience first.',
  },
  {
    title: 'Recent high school graduates',
    text: 'Age 17 or older and ready to start a healthcare career without years of school.',
  },
  {
    title: 'Working adults',
    text: 'Looking for a stable career with room to grow, on a schedule that works around your job.',
  },
];

const whyNow = [
  { value: '7%', label: 'Projected job growth for dental assistants over the next 10 years', src: 'U.S. Bureau of Labor Statistics' },
  { value: '52,900', label: 'Dental assistant openings per year', src: 'U.S. Bureau of Labor Statistics' },
  { value: '#1', label: 'California ranked the top state for dental assistant career growth', src: 'Dental Assisting National Board' },
];

const handsOnRegions = [
  { region: 'Sacramento & North', cities: ['Roseville', 'Fair Oaks', 'Rocklin', 'Chico'] },
  { region: 'Bay Area', cities: ['Napa', 'Hayward', 'San Jose', 'Sunnyvale'] },
  { region: 'Central Valley', cities: ['Kingsburg', 'Bakersfield'] },
  { region: 'Ventura & Los Angeles', cities: ['Oxnard', 'Ventura', 'Van Nuys', 'Pasadena'] },
  { region: 'Orange County & San Diego', cities: ['Tustin', 'Rancho Santa Margarita', 'San Diego'] },
];
const handsOnCount = handsOnRegions.reduce((n, r) => n + r.cities.length, 0);

const certifications = [
  'Dental Practice Act',
  'HIPAA',
  'OSHA Bloodborne Pathogens',
  'Sexual Harassment Prevention',
  'AHA BLS / CPR',
  'Infection Control',
  'Radiation Safety',
  'Dental Assistant Certification',
];

const inside = [
  {
    n: '#1',
    title: 'How the program works',
    body: 'A self-paced program with three parts. You have 12 months of access, and the fastest students finish in 8 to 12 weeks.',
    points: [
      '300 hours online: videos, readings, quizzes and sessions with our team',
      '3 hands-on classes at a partner dental office, usually Friday to Sunday, at 25+ locations',
      '240-hour internship at a dental clinic, paid or unpaid, and we help you find one',
    ],
    img: 'images/learn-xray.jpg',
    alt: 'A CDA Program student practicing dental X-ray positioning on a classmate.',
  },
  {
    n: '#2',
    title: 'Support from start to finish',
    body: 'You’re never on your own. Our Student Success team is with you for the full 12 months, even if you finish early.',
    points: [
      'Student Success team available 9 AM to 6 PM, Monday through Saturday',
      'Weekly check-ins during your internship',
      'A community of 200+ students sharing jobs, internships and scholarships',
    ],
    img: 'images/learn-chairside.jpg',
    alt: 'A student in protective gear working chairside at a dental operatory.',
  },
  {
    n: '#3',
    title: 'One program, everything included',
    body: 'Your tuition covers the whole program, with no extra fees for classes or materials. Your advisor goes over the details at your appointment.',
    points: [
      'All 300 online hours, 3 hands-on classes and the 240-hour internship',
      'All 8 certifications and licenses',
      'Materials, plus your own pair of scrubs',
    ],
    img: 'images/learn-graduate.jpg',
    alt: 'A CDA Program graduate in scrubs ready for her first dental job.',
  },
];



const faqs = [
  {
    q: 'What is the Initial Student Admissions Appointment?',
    a: 'A free 1-on-1 call with a CDA Program admissions advisor. They’ll answer your questions, send you the student and scholarship applications, and help you plan your start date.',
  },
  {
    q: 'Does booking the appointment commit me to enrolling?',
    a: 'No. The appointment is free and there’s no obligation.',
  },
  {
    q: 'Is the program accredited?',
    a: `The California Dental Assistant Program is an approved continuing education provider through the Dental Board of California, license #${LICENSE}.`,
  },
  {
    q: 'How much does the program cost?',
    a: 'Your admissions advisor goes over tuition and scholarships at your free appointment. Everything is included: online learning, 3 hands-on classes, the 240-hour internship, all 8 certifications and licenses, materials and scrubs.',
  },
  {
    q: 'How long does the program take?',
    a: 'It’s self-paced. You have 12 months of access, and the fastest students finish in 8 to 12 weeks.',
  },
  {
    q: 'When are the hands-on classes?',
    a: 'There are 3 hands-on classes in total. They take place at a partner dental office on its day off, usually Friday, Saturday or Sunday, and you can schedule them any time within your 12 months.',
  },
  {
    q: 'Do I need to find my own internship?',
    a: 'The program includes a 240-hour internship, which can be paid or unpaid. If you need help finding one, we’ll help you.',
  },
  {
    q: 'Who can enroll?',
    a: 'Anyone 17 or older, including pre-dental students, recent high school graduates and working adults. No dental experience needed.',
  },
  {
    q: 'How soon can I start?',
    a: 'You can enroll as soon as the next day (unless it’s a Sunday), depending on advisor availability. Book your admissions appointment to get started.',
  },
];

// "Is this right for me?" quiz
const quiz = [
  {
    key: 'who',
    q: 'Which best describes you?',
    options: [
      { v: 'predental', label: 'Pre-dental student (hygiene or dental school)' },
      { v: 'grad', label: 'Recent high school graduate, 17 or older' },
      { v: 'working', label: 'Working adult looking for a stable career' },
      { v: 'exploring', label: 'Exploring different career options' },
    ],
  },
  {
    key: 'when',
    q: 'When would you like to start?',
    options: [
      { v: 'now', label: 'As soon as possible' },
      { v: 'soon', label: 'In the next 1 to 2 months' },
      { v: 'later', label: 'I’m just exploring for now' },
    ],
  },
  {
    key: 'hours',
    q: 'How many hours a week could you study?',
    options: [
      { v: '8', label: '5 to 10 hours' },
      { v: '15', label: '10 to 20 hours' },
      { v: '25', label: '20 to 30 hours' },
      { v: '35', label: '30 or more hours' },
    ],
  },
];

// Clickable program path
const path = [
  {
    id: 'online',
    step: 'Step 1',
    title: 'Online learning',
    meta: '300 hours · self-paced',
    body: 'Work through videos, readings and quizzes in the student portal, on your own schedule. You also book sessions with the Student Success team along the way.',
    points: ['Mark each lesson complete and move to the next', 'Student Success team available 9 AM to 6 PM, Monday through Saturday', 'A community of 200+ students for questions and support'],
  },
  {
    id: 'handson',
    step: 'Step 2',
    title: 'Hands-on classes',
    meta: '3 classes · weekends',
    body: 'Three hands-on classes in a real dental office with licensed instructors. They run on the office’s day off, usually Friday to Sunday, at one of 25+ partner locations.',
    points: ['3 classes total, not 3 a week', 'Schedule them any time within your 12 months', 'Practice real chairside skills before your internship'],
  },
  {
    id: 'internship',
    step: 'Step 3',
    title: 'Internship',
    meta: '240 hours · dental clinic',
    body: 'Put your training to work in a dental clinic. Your internship can be paid or unpaid, and if you need help finding one, we’ll help you.',
    points: ['Weekly check-ins with Student Success', 'Apply what you learned online in a real office', 'Internship placement help if you need it'],
  },
  {
    id: 'certified',
    step: 'Step 4',
    title: 'Certified and job-ready',
    meta: '8 certifications · included',
    body: 'Finish with all 8 certifications and licenses required to work as a dental assistant in California, ready to apply for your first role.',
    points: ['Dental Assistant Certification, CPR, Radiation Safety and more', 'Job and internship opportunities shared in the community', 'Graduate support for the rest of your 12 months'],
  },
];

const title = 'Virtual Preview | California Dental Assistant Program';
const description =
  'Watch the free Virtual Preview of the California Dental Assistant Program, then book your Initial Student Admissions Appointment.';
---

<Layout title={title} description={description}>
  <!-- Top bar -->
  <a class="topbar" href="#book">
    <span class="wrap topbar-inner">
      <span class="badge"><span class="dot" aria-hidden="true"></span>Free</span>
      <span>Watch the Virtual Preview, then book your appointment</span>
    </span>
  </a>

  <!-- Header -->
  <header class="site-header">
    <div class="wrap header-inner">
      <a href={MAIN_SITE} class="brand" aria-label="California Dental Assistant Program home">
        <img src={asset('images/logo-lockup.png')} alt="California Dental Assistant Program" width="276" height="86" />
      </a>
      <div class="header-actions">
        <a href={PHONE_HREF} class="header-phone">{PHONE}</a>
        <a href="#book" class="btn btn-gold btn-sm">Book appointment</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- Hero: the Virtual Preview -->
    <section class="hero">
      <div class="wrap hero-inner">
        <div class="hero-head">
          <h1>
            <span class="h1-line">Dental Assistant Program</span>
            <span class="h1-sep"> · </span>
            <span class="h1-line h1-accent">Virtual Preview</span>
          </h1>
          <p class="hero-sub">
            Watch this free 9-minute preview to see how you could become a dental assistant in as little as 8 to 12 weeks.
            Then book your admissions appointment to get your personal plan.
          </p>
        </div>

        <div class="watch">
          <div class={`player ${video?.kind === 'file' ? 'player-file' : ''}`} id="preview">
            {video?.kind === 'iframe' && (
              <iframe
                src={video.src}
                title="CDA Program Virtual Preview"
                allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
                allowfullscreen
              ></iframe>
            )}
            {video?.kind === 'file' && (
              <>
                <video
                  id="preview-video"
                  controls
                  playsinline
                  preload="none"
                  data-hls={asset(PREVIEW_VIDEO_STREAM)}
                  data-mp4={video.src}
                >
                  <track kind="captions" src={asset(PREVIEW_VIDEO_CAPTIONS)} srclang="en" label="English" />
                </video>
                <button class="cover" type="button" data-play aria-label="Play the Virtual Preview, 8 minutes 46 seconds">
                  <img src={asset('images/hero-clinic.jpg')} alt="" width="1600" height="1066" />
                  <span class="cover-text">
                    <span class="cover-eyebrow">Free Virtual Preview</span>
                    <span class="cover-title">See how the Dental Assistant Program works</span>
                    <span class="cover-meta">8:46 · Recorded live</span>
                  </span>
                  <span class="play" aria-hidden="true"></span>
                </button>
              </>
            )}
            {!video && (
              <div class="player-placeholder" style={`background-image:url(${asset('images/hero-clinic.jpg')})`}>
                <span class="play" aria-hidden="true"></span>
                <span class="player-note">Virtual Preview recording goes here</span>
              </div>
            )}
          </div>
          {video?.kind === 'file' && (
            <nav class="chapters" aria-label="Jump to a part of the preview">
              <span class="chapters-head">Jump to</span>
              <ol>
                {chapters.map((c) => (
                  <li>
                    <button type="button" data-seek={c.t}>
                      <span class="chapter-time">{c.time}</span> {c.label}
                    </button>
                  </li>
                ))}
              </ol>
            </nav>
          )}
        </div>

        <div class="hero-cta">
          <a href="#book" class="btn btn-gold btn-lg">{BOOK_LABEL} <span class="arrow" aria-hidden="true">→</span></a>
          <span class="cta-note">Free 1-on-1 call with an admissions advisor · No obligation</span>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="stats" aria-label="Program results">
      <div class="wrap stats-grid">
        {stats.map((s) => (
          <div class="stat">
            <span class="stat-value" data-count={s.value}>{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Next step: the appointment -->
    <section class="section next">
      <div class="wrap next-grid">
        <div class="next-copy">
          <span class="eyebrow">Your next step</span>
          <h2>Book your Initial Student Admissions Appointment</h2>
          <p>
            The preview shows you how the program works. Your appointment turns it into a plan for you. In one free call,
            an admissions advisor will cover:
          </p>
          <a href="#book" class="btn btn-gold">{BOOK_LABEL} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <ol class="agenda">
          {appointment.map((a) => (
            <li>
              <span class="agenda-label">{a.label}</span>
              <p>{a.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Who it's for + why now -->
    <section class="section who">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Who this is for</span>
          <h2>Built for busy people who want a stable healthcare career</h2>
        </div>
        <ul class="audience">
          {audience.map((a) => (
            <li>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </li>
          ))}
        </ul>

        <div class="why">
          <div class="why-head">
            <span class="eyebrow">Why now</span>
            <h3>California needs dental assistants</h3>
            <p>There’s a dental assistant shortage, and demand keeps growing.</p>
          </div>
          <dl class="why-stats">
            {whyNow.map((w) => (
              <div class="why-stat">
                <dt data-count={w.value}>{w.value}</dt>
                <dd>
                  {w.label}
                  <span class="why-src">Source: {w.src}</span>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- Quiz -->
    <section class="section quiz" id="quiz">
      <div class="wrap quiz-grid">
        <div class="quiz-intro">
          <span class="eyebrow">Quick check</span>
          <h2>Is the Dental Assistant Program right for you?</h2>
          <p>Answer 3 quick questions to see how the program could fit your life. It takes about 20 seconds.</p>
        </div>
        <div class="quiz-card" data-quiz>
          <div class="quiz-progress" aria-hidden="true"><span data-quiz-bar></span></div>
          {quiz.map((item, i) => (
            <fieldset class="quiz-step" data-quiz-step={i} hidden={i !== 0}>
              <legend>
                <span class="quiz-count">Question {i + 1} of {quiz.length}</span>
                <span class="quiz-q">{item.q}</span>
              </legend>
              <div class="quiz-options">
                {item.options.map((o) => (
                  <button type="button" class="quiz-option" data-key={item.key} data-value={o.v}>
                    {o.label}
                  </button>
                ))}
              </div>
              {i > 0 && (
                <button type="button" class="quiz-back" data-quiz-back>
                  ← Back
                </button>
              )}
            </fieldset>
          ))}
          <div class="quiz-result" data-quiz-result hidden aria-live="polite">
            <span class="quiz-count">Your result</span>
            <h3 data-result-title>Looks like a great fit</h3>
            <p data-result-who></p>
            <p data-result-time></p>
            <p data-result-when></p>
            <div class="quiz-actions">
              <a href="#book" class="btn btn-gold">{BOOK_LABEL} <span class="arrow" aria-hidden="true">→</span></a>
              <button type="button" class="quiz-retake" data-quiz-retake>Retake the quiz</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Program path + finish-time calculator -->
    <section class="section path" id="path">
      <div class="wrap">
        <div class="path-pin" data-path-pin>
        <div class="section-head">
          <span class="eyebrow">How it works</span>
          <h2>Your path, step by step</h2>
          <p>Keep scrolling to walk through each step, or tap one to jump to it.</p>
        </div>
        <div class="path-tabs" role="tablist" aria-label="Program steps">
          <span class="path-progress" aria-hidden="true"><span class="path-progress-fill" data-path-fill></span></span>
          {path.map((p, i) => (
            <button
              type="button"
              role="tab"
              class="path-tab"
              id={`tab-${p.id}`}
              aria-controls={`panel-${p.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-path-tab
            >
              <span class="path-dot" aria-hidden="true">{i + 1}</span>
              <span class="path-tab-text">
                <span class="path-step">{p.step}</span>
                <span class="path-title">{p.title}</span>
              </span>
            </button>
          ))}
        </div>
        <div class="path-panels" data-path-panels>
        <span class="path-rail" aria-hidden="true"><span class="path-rail-fill" data-path-rail-fill></span></span>
        {path.map((p, i) => (
          <div
            class="path-panel"
            role="tabpanel"
            id={`panel-${p.id}`}
            aria-labelledby={`tab-${p.id}`}
            hidden={i !== 0}
            data-path-panel
          >
            <div class="path-panel-head">
              <span class="path-panel-step">Step {i + 1} of {path.length}</span>
              <span class="path-meta">{p.meta}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
            <ul class="checks">
              {p.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </div>
        ))}
        </div>
        </div>

        <div class="calc" data-calc>
          <div class="calc-copy">
            <span class="eyebrow">Finish-time calculator</span>
            <h3>How fast could you finish your online coursework?</h3>
            <label for="calc-hours" class="calc-label">
              Hours a week you can study: <strong data-calc-hours>15</strong>
            </label>
            <input id="calc-hours" type="range" min="5" max="40" step="1" value="15" data-calc-input />
            <div class="calc-scale" aria-hidden="true"><span>5</span><span>40</span></div>
          </div>
          <div class="calc-out" aria-live="polite">
            <div class="calc-big">
              <span class="calc-num" data-calc-weeks>20</span>
              <span class="calc-unit">weeks</span>
            </div>
            <p class="calc-date">Estimated finish: <strong data-calc-date>about 20 weeks from today</strong></p>
            <div class="calc-track" aria-hidden="true">
              <span class="calc-fill" data-calc-fill></span>
            </div>
            <p class="calc-track-label">Your 12 months of access</p>
            <p class="calc-warn" data-calc-warn hidden>
              At this pace you’d go past your 12 months. Aim for at least 6 hours a week.
            </p>
          </div>
          <p class="calc-note">
            Based on the 300 hours of online learning. Your 3 hands-on classes and 240-hour internship are scheduled with
            your advisor. The fastest students finish the whole program in 8 to 12 weeks.
          </p>
        </div>
      </div>
    </section>

    <!-- Inside the preview -->
    <section class="section inside">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Inside the preview</span>
          <h2>Three things you’ll learn in the preview</h2>
          <p>It follows the same path a new student does, from first lesson to first paycheck.</p>
        </div>
        <ol class="inside-list">
          {inside.map((item, i) => (
            <li class={`inside-row ${i % 2 ? 'flip' : ''}`}>
              <div class="inside-media">
                <img src={asset(item.img)} alt={item.alt} loading="lazy" width="900" height="1273" />
              </div>
              <div class="inside-copy">
                <span class="inside-num">{item.n}</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                <ul class="checks">
                  {item.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
        <div class="center-cta">
          <a href="#book" class="btn btn-gold">{BOOK_LABEL} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- Certifications -->
    <section class="section certs">
      <div class="wrap certs-grid">
        <div class="certs-head">
          <span class="eyebrow eyebrow-light">Included in your tuition</span>
          <h2>All 8 certifications and licenses you need to work in California</h2>
          <p>Every certification required to practice as a dental assistant in California is part of the program.</p>
          <a href="#book" class="btn btn-gold">{BOOK_LABEL} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <ul class="cert-list checks checks-light">
          {certifications.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Hands-on class locations -->
    <section class="locations" id="locations">
      <h2 class="loc-title">Hands-on training close to home</h2>
      <div class="loc-band">
        <ul class="loc-list">
          {handsOnRegions.map((r) => (
            <li>
              <h3>{r.region}</h3>
              <p>{r.cities.join(', ')}</p>
            </li>
          ))}
        </ul>
        <div class="wrap loc-foot">
          <p><strong>These locations are for hands-on classes only.</strong> Lessons, videos and quizzes are completed online from anywhere. You only travel to a location for your scheduled in-person, hands-on lab classes. <strong>Not sure which is closest?</strong> Your admissions advisor will help you pick the location that works best for you.</p>
          <a class="btn btn-gold" href="#book">Book your appointment <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- Social proof: Google rating bar + California map of reviews -->
    <link rel="stylesheet" href={asset('reviews/reviews.css')} />
    <section class="proof" id="reviews" data-reviews data-photo={asset('images/clinic-group.jpg')} data-logo={asset('images/logo-seal.png')}></section>

    <!-- Ana's video testimonial -->
    <section class="section ana">
      <div class="wrap ana-grid">
        <div class="ana-copy">
          <span class="eyebrow">Hear it from a student</span>
          <h2>Ana on her CDA Program experience</h2>
          <a class="btn btn-gold" href="#book">Book your appointment <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <figure class="video-card">
          <video controls preload="none" playsinline poster={asset('videos/testimonial-poster.jpg')} aria-label="Dental assistant student testimonial video">
