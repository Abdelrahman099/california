  <script is:inline src={GHL_EMBED_SCRIPT}></script>
  <script is:inline src={asset('reviews/reviews-data.js')}></script>
  <script is:inline src={asset('reviews/ca-counties.js')}></script>
  <script is:inline src={asset('reviews/reviews.js')}></script>
  <script>
    // Virtual Preview player: streams the video (works on iPhone and every browser),
    // hides the cover when it starts, and handles chapter jumps.
    const v = document.getElementById('preview-video') as HTMLVideoElement | null;
    if (v) {
      const cover = document.querySelector<HTMLElement>('[data-play]');
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-seek]'));
      let attached: Promise<void> | null = null;
      let started = false;

      const attach = () => {
        if (attached) return attached;
        attached = (async () => {
          const hlsUrl = v.dataset.hls || '';
          const mp4Url = v.dataset.mp4 || '';
          if (hlsUrl && v.canPlayType('application/vnd.apple.mpegurl')) {
            v.src = hlsUrl; // Safari and iPhone play streams natively
            return;
          }
          try {
            const { default: Hls } = await import('hls.js');
            if (hlsUrl && Hls.isSupported()) {
              const hls = new Hls({ startPosition: 0 });
              hls.loadSource(hlsUrl);
              hls.attachMedia(v);
              return;
            }
          } catch (e) {
            /* fall back to the plain file below */
          }
          v.src = mp4Url;
        })();
        return attached;
      };

      const start = async (t?: number) => {
        if (cover) cover.hidden = true;
        started = true;
        await attach();
        if (typeof t === 'number') {
          const seek = () => {
            v.currentTime = t;
          };
          if (v.readyState >= 1) seek();
          else v.addEventListener('loadedmetadata', seek, { once: true });
        }
        v.play().catch(() => {});
      };

      cover?.addEventListener('click', () => start());
      v.addEventListener('play', () => {
        if (cover) cover.hidden = true;
      });
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          start(Number(b.dataset.seek));
          v.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }),
      );
      // Booking nudge once 75% of the preview has played.
      const nudge = document.querySelector<HTMLElement>('[data-nudge]');
      let nudged = false;
      try {
        nudged = sessionStorage.getItem('cdaNudge') === '1';
      } catch (e) {}
      const showNudge = () => {
        if (nudged || !nudge) return;
        nudged = true;
        nudge.hidden = false;
        requestAnimationFrame(() => nudge.classList.add('is-in'));
        try {
          sessionStorage.setItem('cdaNudge', '1');
        } catch (e) {}
      };
      v.addEventListener('timeupdate', () => {
        if (v.duration && v.currentTime / v.duration >= 0.75) showNudge();
      });
      v.addEventListener('ended', showNudge);

      v.addEventListener('timeupdate', () => {
        let cur: HTMLButtonElement | null = null;
        for (const b of buttons) if (v.currentTime >= Number(b.dataset.seek)) cur = b;
        buttons.forEach((b) => b.classList.toggle('is-current', started && b === cur));
      });
    }
  </script>
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---------- Quiz ----------
    const quizEl = document.querySelector<HTMLElement>('[data-quiz]');
    if (quizEl) {
      const steps = Array.from(quizEl.querySelectorAll<HTMLElement>('[data-quiz-step]'));
      const result = quizEl.querySelector<HTMLElement>('[data-quiz-result]')!;
      const bar = quizEl.querySelector<HTMLElement>('[data-quiz-bar]')!;
      const answers: Record<string, string> = {};
      let current = 0;
      const total = steps.length;

      const whoText: Record<string, string> = {
        predental:
          'The program is built for pre-dental students. You’ll get real chairside experience before hygiene or dental school.',
        grad: 'If you’re 17 or older, you can start a healthcare career in weeks, not years.',
        working:
          'It’s self-paced, and hands-on classes usually run Friday to Sunday, so you can keep working while you train.',
        exploring:
          'Dental assisting is in demand in California. Your advisor can help you decide if it’s the right fit.',
      };
      const whenText: Record<string, string> = {
        now: 'You can enroll as soon as the next day, depending on advisor availability.',
        soon: 'Your advisor can map out a start date that fits your timeline.',
        later: 'No pressure. A free call is the quickest way to get your questions answered.',
      };

      const show = (i: number) => {
        current = i;
        steps.forEach((s, n) => (s.hidden = n !== i));
        result.hidden = i < total;
        bar.style.width = `${(Math.min(i, total) / total) * 100}%`;
        const first = i < total ? steps[i].querySelector<HTMLElement>('.quiz-option') : result.querySelector<HTMLElement>('a');
        first?.focus({ preventScroll: true });
      };

      const finish = () => {
        const hours = Number(answers.hours || 15);
        const weeks = Math.ceil(300 / hours);
        result.querySelector('[data-result-title]')!.textContent =
          answers.who === 'exploring' ? 'Worth a closer look' : 'Looks like a great fit';
        result.querySelector('[data-result-who]')!.textContent = whoText[answers.who] || '';
        result.querySelector('[data-result-time]')!.textContent =
          `At about ${hours} hours a week, you could finish the online coursework in about ${weeks} weeks.`;
        result.querySelector('[data-result-when]')!.textContent = whenText[answers.when] || '';
        show(total);
        const calcInput = document.querySelector<HTMLInputElement>('[data-calc-input]');
        if (calcInput) {
          calcInput.value = String(hours);
          calcInput.dispatchEvent(new Event('input'));
        }
      };

      quizEl.querySelectorAll<HTMLButtonElement>('.quiz-option').forEach((btn) =>
        btn.addEventListener('click', () => {
          answers[btn.dataset.key!] = btn.dataset.value!;
          btn.parentElement!.querySelectorAll('.quiz-option').forEach((b) => b.classList.toggle('is-picked', b === btn));
          window.setTimeout(() => (current + 1 < total ? show(current + 1) : finish()), reduceMotion ? 0 : 180);
        }),
      );
      quizEl.querySelectorAll('[data-quiz-back]').forEach((b) => b.addEventListener('click', () => show(Math.max(0, current - 1))));
      quizEl.querySelector('[data-quiz-retake]')?.addEventListener('click', () => {
        Object.keys(answers).forEach((k) => delete answers[k]);
        quizEl.querySelectorAll('.is-picked').forEach((b) => b.classList.remove('is-picked'));
        show(0);
      });
    }

    // ---------- Program path: tabs + GSAP scroll animation ----------
    const pathSection = document.getElementById('path');
    const pathPin = document.querySelector<HTMLElement>('[data-path-pin]');
    const pathFill = document.querySelector<HTMLElement>('[data-path-fill]');
    const railFill = document.querySelector<HTMLElement>('[data-path-rail-fill]');
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-path-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-path-panel]'));
    const stepCount = panels.length;
    let currentStep = 0;
    let scrollDriven = false; // true while GSAP controls which panel is shown
    let scrollToStep: ((i: number) => void) | null = null;

    const setActive = (i: number, focus = false) => {
      currentStep = i;
      tabs.forEach((t, n) => {
        const on = n === i;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        t.classList.toggle('is-done', n < i);
        if (on && focus) t.focus({ preventScroll: true });
      });
      if (!scrollDriven) {
        panels.forEach((p, n) => (p.hidden = n !== i));
        if (pathFill) pathFill.style.transform = `scaleX(${stepCount > 1 ? i / (stepCount - 1) : 1})`;
      }
    };
    const goTo = (i: number, focus = false) => {
      if (scrollToStep) {
        scrollToStep(i);
        if (focus) tabs[i]?.focus({ preventScroll: true });
      } else setActive(i, focus);
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => goTo(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          goTo((i + 1) % stepCount, true);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          goTo((i - 1 + stepCount) % stepCount, true);
        }
      });
    });

    if (pathSection && pathPin && pathFill && stepCount > 1) {
      const mm = gsap.matchMedia();
      mm.add(
        {
          desktop: '(min-width: 901px)',
          mobile: '(max-width: 900px)',
          reduce: '(prefers-reduced-motion: reduce)',
        },
        (ctx) => {
          const { desktop, reduce } = ctx.conditions as { desktop: boolean; mobile: boolean; reduce: boolean };
          if (reduce) return;
          scrollDriven = true;
          panels.forEach((p) => (p.hidden = false));

          if (desktop) {
            // Pin the section and scrub through the steps as the visitor scrolls.
            pathSection.classList.add('is-scrolly');
            const header = document.querySelector<HTMLElement>('.site-header');
            const offset = () => (header?.offsetHeight ?? 0) + 24;
            const last = stepCount - 1;

            gsap.set(panels, { autoAlpha: 0, y: 28 });
            gsap.set(panels[0], { autoAlpha: 1, y: 0 });

            const tl = gsap.timeline({
              defaults: { ease: 'power2.out' },
              scrollTrigger: {
                trigger: pathPin,
                start: () => `top top+=${offset()}`,
                end: () => `+=${Math.round(window.innerHeight * 0.75 * last)}`,
                pin: true,
                scrub: 0.5,
                anticipatePin: 1,
                invalidateOnRefresh: true,
                snap: {
                  snapTo: (v: number) => Math.round(v * last) / last,
                  inertia: false,
                  directional: false,
                  duration: { min: 0.2, max: 0.5 },
                  delay: 0.1,
                  ease: 'power1.inOut',
                },
                onUpdate: (self) => {
                  const i = Math.round(self.progress * last);
                  if (i !== currentStep) setActive(i);
                },
              },
            });

            tl.fromTo(pathFill, { scaleX: 0 }, { scaleX: 1, ease: 'none', duration: last }, 0);
            for (let i = 1; i <= last; i++) {
              const at = i - 0.75;
              tl.to(panels[i - 1], { autoAlpha: 0, y: -28, duration: 0.3 }, at)
                .fromTo(panels[i], { autoAlpha: 0, y: 28 }, { autoAlpha: 1, y: 0, duration: 0.35 }, at + 0.25)
                .fromTo(
                  panels[i].querySelectorAll('.checks li'),
                  { autoAlpha: 0, x: -16 },
                  { autoAlpha: 1, x: 0, stagger: 0.06, duration: 0.2 },
                  at + 0.4,
                );
            }

            const st = tl.scrollTrigger!;
            scrollToStep = (i: number) => {
              const y = st.start + ((st.end - st.start) * i) / last;
              window.scrollTo({ top: Math.ceil(y) + 1, behavior: 'smooth' });
            };
          } else {
            // Phones: a vertical timeline that draws itself as you scroll.
            pathSection.classList.add('is-vertical');
            if (railFill) {
              gsap.fromTo(
                railFill,
                { scaleY: 0 },
                {
                  scaleY: 1,
                  ease: 'none',
                  scrollTrigger: { trigger: '[data-path-panels]', start: 'top 70%', end: 'bottom 65%', scrub: 0.4 },
                },
              );
            }
            panels.forEach((p) => {
              gsap.fromTo(
                p,
                { autoAlpha: 0, y: 36 },
                {
                  autoAlpha: 1,
                  y: 0,
                  duration: 0.6,
                  ease: 'power2.out',
                  scrollTrigger: { trigger: p, start: 'top 88%', toggleActions: 'play none none reverse' },
                },
              );
              ScrollTrigger.create({
                trigger: p,
                start: 'top 65%',
                end: 'bottom 65%',
                toggleClass: { targets: p, className: 'is-active' },
              });
            });
          }

          return () => {
            scrollDriven = false;
            scrollToStep = null;
            pathSection.classList.remove('is-scrolly', 'is-vertical');
            panels.forEach((p) => p.classList.remove('is-active'));
            setActive(currentStep);
          };
        },
      );

      window.addEventListener('cda:ready', () => ScrollTrigger.refresh());

      // The quiz above changes height when it shows a result; re-measure so the pin lines up.
      const quizCard = document.querySelector('[data-quiz]');
      if (quizCard && 'ResizeObserver' in window) {
        let t = 0;
        new ResizeObserver(() => {
          window.clearTimeout(t);
          t = window.setTimeout(() => ScrollTrigger.refresh(), 150);
        }).observe(quizCard);
      }
    }

    // ---------- Finish-time calculator ----------
    const calc = document.querySelector<HTMLElement>('[data-calc]');
    if (calc) {
      const input = calc.querySelector<HTMLInputElement>('[data-calc-input]')!;
      const hoursOut = calc.querySelector<HTMLElement>('[data-calc-hours]')!;
      const weeksOut = calc.querySelector<HTMLElement>('[data-calc-weeks]')!;
      const dateOut = calc.querySelector<HTMLElement>('[data-calc-date]')!;
      const fill = calc.querySelector<HTMLElement>('[data-calc-fill]')!;
      const warn = calc.querySelector<HTMLElement>('[data-calc-warn]')!;
      const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
      const update = () => {
        const hours = Number(input.value);
        const weeks = Math.ceil(300 / hours);
        const finish = new Date();
        finish.setDate(finish.getDate() + weeks * 7);
        hoursOut.textContent = String(hours);
        weeksOut.textContent = String(weeks);
        dateOut.textContent = fmt.format(finish);
        fill.style.width = `${Math.min(100, (weeks / 52) * 100)}%`;
        fill.classList.toggle('is-over', weeks > 52);
        warn.hidden = weeks <= 52;
        const pct = ((hours - Number(input.min)) / (Number(input.max) - Number(input.min))) * 100;
        input.style.setProperty('--fill', `${pct}%`);
      };
      input.addEventListener('input', update);
      update();
    }

    // ---------- Booking calendar dialog ----------
    const dialog = document.querySelector<HTMLDialogElement>('[data-cal-dialog]');
    const nudgeEl = document.querySelector<HTMLElement>('[data-nudge]');
    const hideNudge = () => {
      if (!nudgeEl) return;
      nudgeEl.classList.remove('is-in');
      window.setTimeout(() => (nudgeEl.hidden = true), reduceMotion ? 0 : 250);
    };
    document.querySelector('[data-nudge-close]')?.addEventListener('click', hideNudge);
    document.querySelector('[data-cal-open]')?.addEventListener('click', () => {
      hideNudge();
      const frame = dialog?.querySelector<HTMLIFrameElement>('iframe');
      if (frame && !frame.src && frame.dataset.src) frame.src = frame.dataset.src;
      if (dialog && typeof dialog.showModal === 'function') dialog.showModal();
      else document.getElementById('book')?.scrollIntoView({ behavior: 'smooth' });
    });
    document.querySelector('[data-cal-close]')?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    // ---------- Motion: count-up numbers and scroll reveals ----------
    // Start once the preloader has gone, so the first numbers count up where people can see them.
    const whenReady = (fn: () => void) =>
      document.documentElement.classList.contains('is-loading')
        ? window.addEventListener('cda:ready', fn, { once: true })
        : fn();
    if (!reduceMotion && 'IntersectionObserver' in window) whenReady(() => {
      const countEls = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));
      const animate = (el: HTMLElement) => {
        const raw = el.dataset.count || '';
        const m = raw.match(/^(\D*)([\d,]+)(\D*)$/);
        if (!m) return;
        const [, pre, num, post] = m;
        const target = Number(num.replace(/,/g, ''));
        const useComma = num.includes(',');
        const start = performance.now();
        const dur = 1100;
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          const val = Math.round(target * eased);
          el.textContent = pre + (useComma ? val.toLocaleString('en-US') : String(val)) + post;
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const countIO = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              animate(e.target as HTMLElement);
              countIO.unobserve(e.target);
            }
          }),
        { threshold: 0.6 },
      );
      countEls.forEach((el) => countIO.observe(el));

      const revealSel =
        '.section-head, .next-copy, .agenda li, .audience li, .why, .quiz-intro, .quiz-card, .calc, .inside-row, .certs-head, .cert-list, .loc-foot, .ana-copy, .video-card, .book-copy, .faq-intro';
      const revealEls = Array.from(document.querySelectorAll<HTMLElement>(revealSel)).filter(
        (el) => el.getBoundingClientRect().top > window.innerHeight && !el.closest('[data-path-pin]'),
      );
      revealEls.forEach((el) => el.classList.add('will-reveal'));
      const revealIO = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-revealed');
              revealIO.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      revealEls.forEach((el) => revealIO.observe(el));
    });

  </script>
  <script is:inline>
    // Hide the phone booking bar while the calendar itself is on screen.
    (function () {
      var bar = document.querySelector('[data-mobile-bar]');
      var book = document.getElementById('book');
      if (!bar || !book || !('IntersectionObserver' in window)) return;
      new IntersectionObserver(function (entries) {
        bar.classList.toggle('is-hidden', entries[0].isIntersecting);
      }).observe(book);
    })();
  </script>
